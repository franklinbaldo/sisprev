---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MetadataGrid from "../../components/MetadataGrid.astro";
import RelationList from "../../components/RelationList.astro";
import ListaDeFontes from "../../components/ListaDeFontes.astro";
import { rotuloDaRedacao, rotuloDoEndereco } from "../../lib/dispositivo";
import { href } from "../../consts";

export async function getStaticPaths() {
  const [dispositivos, regras, normas] = await Promise.all([
    getCollection("dispositivos"),
    getCollection("regras"),
    getCollection("normas"),
  ]);
  const apelidoPorId = new Map(normas.map((n) => [n.data.id, n.data.apelido]));

  return dispositivos.map((entry) => {
    const ref = `/dispositivos/${entry.data.id}.md`;
    const citingRegras = regras.filter((regra) => regra.data.dispositivos.includes(ref));
    // O dispositivo é o diretório; as redações são os arquivos dentro dele.
    // "Todas as redações deste dispositivo" é, portanto, um prefixo de id —
    // a pergunta que o slug plano anterior não conseguia responder, porque
    // fundia dispositivo e redação num token só.
    const enderecoId = entry.data.id.slice(0, entry.data.id.lastIndexOf("/"));
    // Em ordem cronológica: a sucessão de redações de um dispositivo é uma
    // linha do tempo, e o Python já garante que as janelas não se sobrepõem.
    // `vigencia_inicio` ausente (redação original sem data levantada) vai
    // para o começo, que é onde ela está.
    const redacoes = dispositivos
      .filter((d) => d.data.id.startsWith(`${enderecoId}/`))
      .sort(
        (a, b) =>
          (a.data.vigencia_inicio?.getTime() ?? 0) - (b.data.vigencia_inicio?.getTime() ?? 0) ||
          a.data.id.localeCompare(b.data.id),
      );
    return { params: { id: entry.data.id }, props: { entry, citingRegras, redacoes, apelidoPorId } };
  });
}

const { entry, citingRegras, redacoes, apelidoPorId } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;

const norma = await getEntry("normas", entry.data.norma);
const nomeDaNorma = norma?.data.nome ?? entry.data.norma;
const redacaoId = entry.data.id.slice(entry.data.id.lastIndexOf("/") + 1);
const rotulo = rotuloDoEndereco(entry.data.componentes);
const redacao = rotuloDaRedacao(redacaoId, apelidoPorId.get(redacaoId));

// UTC, não hora local do build: as datas de vigência são calendário puro
// (YAML `2021-10-18` já chega como meia-noite UTC), e ler em fuso local
// arriscaria cair no dia anterior/seguinte dependendo do servidor.
const dataBr = (d: Date | undefined) =>
  d
    ? `${String(d.getUTCDate()).padStart(2, "0")}/${String(d.getUTCMonth() + 1).padStart(2, "0")}/${d.getUTCFullYear()}`
    : "";
---

<BaseLayout title={`${nomeDaNorma} — ${rotulo}`} description={`${rotulo} da ${nomeDaNorma} (${redacao}).`}>
  <Breadcrumbs
    itens={[
      { label: "Início", href: href("", base) },
      { label: "Dispositivos", href: href("dispositivos/", base) },
      { label: nomeDaNorma, href: href(`normas/${entry.data.norma}/`, base) },
    ]}
  />

  <header class="ficha-cabecalho">
    <h1>{nomeDaNorma} — {rotulo}</h1>
    <p>{redacao}</p>
  </header>

  <MetadataGrid
    items={[
      { label: "Norma", value: nomeDaNorma, bruto: entry.data.norma, href: href(`normas/${entry.data.norma}/`, base) },
      { label: "Dispositivo", value: rotulo, bruto: entry.data.id },
      {
        label: "Redação dada por",
        value: apelidoPorId.get(redacaoId) ?? "",
        bruto: entry.data.redacao_dada_por ?? null,
        href: entry.data.redacao_dada_por ? href(`normas/${entry.data.redacao_dada_por}/`, base) : undefined,
      },
      { label: "Vigência a partir de", value: dataBr(entry.data.vigencia_inicio) },
      { label: "Vigência até", value: dataBr(entry.data.vigencia_fim) },
    ]}
  />

  {
    entry.data.componentes.some((c) => c.redacao_dada_por) && (
      <>
        <h2>Procedência de cada nível</h2>
        <p class="nota">
          O texto abaixo mostra a cadeia inteira — o caput do artigo, o do parágrafo e o nível
          endereçado —, e cada nível pode ter sido escrito por uma norma diferente. A vigência do
          documento é o recorte em que esta combinação esteve em vigor: começa com a alteração mais
          recente e termina na primeira alteração seguinte, de qualquer um dos níveis.
        </p>
        <MetadataGrid
          items={entry.data.componentes.map((c) => ({
            label: rotuloDoEndereco([c]),
            value: [
              c.redacao_dada_por ? (apelidoPorId.get(c.redacao_dada_por) ?? c.redacao_dada_por) : "—",
              dataBr(c.vigencia_inicio) ? `desde ${dataBr(c.vigencia_inicio)}` : "",
              dataBr(c.vigencia_fim) ? `até ${dataBr(c.vigencia_fim)}` : "",
            ]
              .filter(Boolean)
              .join(" · "),
            bruto: c.redacao_dada_por ?? null,
          }))}
        />
      </>
    )
  }

  <h2>Texto</h2>
  <div class="document-body">
    <Content />
  </div>

  <ListaDeFontes fontes={entry.data.fontes} titulo="Fonte oficial" />

  {
    redacoes.length > 1 && (
      <>
        <h2>Outras redações deste dispositivo</h2>
        <RelationList
          items={redacoes
            .filter((d) => d.data.id !== entry.data.id)
            .map((d) => {
              const outra = d.data.id.slice(d.data.id.lastIndexOf("/") + 1);
              return {
                href: href(`dispositivos/${d.data.id}/`, base),
                label: rotuloDaRedacao(outra, apelidoPorId.get(outra)),
              };
            })}
        />
      </>
    )
  }

  <h2>Regras que citam este dispositivo</h2>
  <RelationList
    items={citingRegras.map((r) => ({ href: href(`regras/${r.data.id}/`, base), label: r.data.nome }))}
    empty="Nenhuma regra cita este dispositivo ainda."
  />
</BaseLayout>
