---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import StatCard from "../components/StatCard.astro";
import { href } from "../consts";
import { resumoDasRegras, resumoDosAchados } from "../lib/site-data";

const [regras, achados, dispositivos] = await Promise.all([
  getCollection("regras"),
  getCollection("achados"),
  getCollection("dispositivos"),
]);
const base = import.meta.env.BASE_URL;

// Cada número do painel leva à listagem já recortada por ele — o leitor
// confere a contagem clicando, em vez de acreditar nela (mesma linha da
// prova de frescor por SHA da §7: verificável, não assumida).
const regrasFiltradas = (params: Record<string, string>): string =>
  `${href("regras/", base)}?${new URLSearchParams(params).toString()}`;
const achadosFiltrados = (params: Record<string, string>): string =>
  `${href("achados/", base)}?${new URLSearchParams(params).toString()}`;
---

<BaseLayout
  title="Início"
  description="Catálogo de regras de aposentadoria e pensão por morte do Sisprev, em auditoria."
>
  <h1>Sisprev — Catálogo em auditoria</h1>
  <p class="lead">
    Projeção navegável do bundle OKF que registra a auditoria das regras de
    aposentadoria e pensão por morte do Sisprev — regime próprio de
    previdência de Rondônia. Esta é uma projeção derivada, somente-leitura;
    nada aqui se edita neste site.
  </p>

  <section class="downloads-destaque" aria-labelledby="downloads-titulo">
    <div>
      <p class="eyebrow">Downloads</p>
      <h2 id="downloads-titulo">Leve o catálogo com você</h2>
      <p>
        Baixe o relatório completo em PDF ou pacotes Repomix prontos para leitura
        e análise. Cada pacote tem um escopo explícito e é regenerado pelo
        workflow de publicação.
      </p>
    </div>
    <div class="downloads-destaque__links">
      <a class="download-principal" href={href("relatorio-de-validacao.pdf", base)} download>
        Baixar relatório completo em PDF
      </a>
      <a href="https://repomix.com/?repo=https%3A%2F%2Fgithub.com%2Ffranklinbaldo%2Fsisprev&ignore=fontes-oficiais%2F**%2C+data%2F**%2C+docs%2F**%2C+site%2F**%2C+scripts%2F**%2C+tests%2F**%2C+CLAUDE.md">
        Abrir este repositório no Repomix Web
      </a>
    </div>
    <ul class="downloads-list">
      <li><a href={href("downloads/repomix-regras.md", base)} download>Regras do Sisprev</a> <span>— somente o catálogo de regras</span></li>
      <li><a href={href("downloads/repomix-leis.md", base)} download>Dispositivos legais</a> <span>— leis e normas transcritas no OKF</span></li>
      <li><a href={href("downloads/repomix-okf.md", base)} download>Bundle OKF completo</a> <span>— regras, achados e dispositivos</span></li>
      <li><a href={href("downloads/repomix-analises.md", base)} download>Análises e RFCs</a> <span>— documentação metodológica e jurídica</span></li>
    </ul>
  </section>

  <h2>Estado da auditoria</h2>
  <p class="secao-nota">
    Contagens sobre o estado <strong>efetivo</strong> calculado pela biblioteca
    Python (P7/P14) no commit que gerou esta página, não sobre o que está
    escrito no frontmatter de cada ficha. Clique em qualquer número para ver a
    listagem correspondente.
  </p>

  <div class="stat-grid">
    <StatCard rotulo="Regras no catálogo" valor={resumoDasRegras.total} href={href("regras/", base)} />
    <StatCard
      rotulo="Importadas"
      valor={resumoDasRegras.importadas}
      detalhe="ainda não revisadas"
      tone="auditoria"
      href={regrasFiltradas({ status: "importada" })}
    />
    <StatCard
      rotulo="Revisadas"
      valor={resumoDasRegras.revisadas}
      detalhe="sem achado bloqueante aberto"
      tone="auditoria"
      href={regrasFiltradas({ status: "revisada" })}
    />
    <StatCard
      rotulo="Validadas"
      valor={resumoDasRegras.validadas}
      detalhe="ciclo institucional concluído"
      tone="validado"
      href={regrasFiltradas({ status: "validada" })}
    />
  </div>

  <h3>Validação institucional</h3>
  <div class="stat-grid">
    <StatCard rotulo="Com validação da PGE" valor={resumoDasRegras.validadoPge} detalhe={`de ${resumoDasRegras.total}`} />
    <StatCard
      rotulo="Com validação da Presidência"
      valor={resumoDasRegras.validadoPresidencia}
      detalhe={`de ${resumoDasRegras.total}`}
    />
    <StatCard
      rotulo="Com as duas"
      valor={resumoDasRegras.validadoAmbos}
      detalhe="PGE e Presidência"
      tone={resumoDasRegras.validadoAmbos > 0 ? "validado" : "neutro"}
    />
  </div>

  <h3>Por ciclo de validação</h3>
  <ul class="relation-list">
    {
      resumoDasRegras.porCiclo.map((ciclo) => (
        <li>
          <a href={regrasFiltradas({ ciclo: ciclo.ciclo })}>
            Ciclo {ciclo.ciclo} — {ciclo.total} regra(s)
          </a>
        </li>
      ))
    }
  </ul>

  <h3>Achados de auditoria</h3>
  <div class="stat-grid">
    <StatCard
      rotulo="Abertos e bloqueantes"
      valor={resumoDosAchados.abertosBloqueantes}
      detalhe="impedem o estado revisada"
      tone={resumoDosAchados.abertosBloqueantes > 0 ? "bloqueante" : "neutro"}
      href={achadosFiltrados({ situacao: "aberto", severidade: "bloqueante" })}
    />
    <StatCard
      rotulo="Abertos e informativos"
      valor={resumoDosAchados.abertosInformativos}
      href={achadosFiltrados({ situacao: "aberto", severidade: "informativo" })}
    />
    <StatCard
      rotulo="Improcedentes"
      valor={resumoDosAchados.improcedentes}
      tone="validado"
      href={achadosFiltrados({ situacao: "improcedente" })}
    />
    <StatCard
      rotulo="Dispositivos legais"
      valor={dispositivos.length}
      detalhe="citados e transcritos"
      href={href("dispositivos/", base)}
    />
  </div>

  <h2>Por onde começar</h2>
  <div class="atalhos">
    <a href={href("regras/", base)} class="atalho">
      <strong>Regras</strong>
      <span>As {regras.length} regras do catálogo, com busca e filtros por tipo, ciclo e estado.</span>
    </a>
    <a href={href("achados/", base)} class="atalho">
      <strong>Achados</strong>
      <span>Os {achados.length} achados de auditoria e as regras que cada um afeta.</span>
    </a>
    <a href={href("dispositivos/", base)} class="atalho">
      <strong>Dispositivos</strong>
      <span>O texto legal verbatim de cada dispositivo citado, e quem o cita.</span>
    </a>
    <a href={href("simulador/", base)} class="atalho">
      <strong>Simulador</strong>
      <span>Filtro exploratório de regras a partir dos fatos de um requerimento. Não decide.</span>
    </a>
    <a href={href("relatorio/", base)} class="atalho">
      <strong>Relatório de validação</strong>
      <span>O catálogo inteiro como um documento único, um capítulo por regra — para ler aqui ou baixar em PDF.</span>
    </a>
    <a href={href("relatorio-ciclo/", base)} class="atalho">
      <strong>Relatórios de fechamento de ciclo</strong>
      <span>
        O que cada ciclo propõe pôr no lugar das regras que audita, um capítulo por grupo de
        substituição.
      </span>
    </a>
  </div>
</BaseLayout>
