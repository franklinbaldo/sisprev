---
// Listagem das propostas que têm relatório de fechamento.
//
// Existe para que as páginas de `/relatorio-ciclo/<id>/` sejam alcançáveis: o
// relatório em si sai do índice de busca (repete o conteúdo das regras
// propostas e venceria a ficha própria de cada uma), então sem esta listagem
// ele só seria acessível por quem já soubesse a URL.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntityCard from "../../components/EntityCard.astro";
import { href } from "../../consts";
import { gruposDaCadeia } from "../../lib/relatorio-ciclo";

const base = import.meta.env.BASE_URL;
const conjuntos = await getCollection("conjuntos");
// A mesma cadeia que a página do relatório percorre, e pela mesma razão: um
// conjunto de fechamento não declara delta próprio. Contar só o que ele
// declara listaria "0 grupos" ao lado de um documento com dois capítulos.
const porId = new Map(conjuntos.map((entrada) => [entrada.data.id, entrada.data]));

const propostas = conjuntos
  .map((entrada) => ({ entrada, grupos: gruposDaCadeia(entrada.data.id, porId) }))
  .filter(({ grupos }) => grupos.length > 0)
  .map(({ entrada, grupos }) => {
    return {
      id: entrada.data.id,
      nome: entrada.data.nome,
      situacao: entrada.data.situacao,
      grupos: grupos.length,
      // Sem repetição, pela mesma razão da capa: a mesma regra legada em dois
      // grupos contada duas vezes afirma uma proposta maior que a real.
      origens: new Set(grupos.flatMap((grupo) => grupo.origens)).size,
      destinos: new Set(grupos.flatMap((grupo) => grupo.destinos)).size,
    };
  })
  .sort((a, b) => a.id.localeCompare(b.id, "pt-BR"));
---

<BaseLayout
  title="Relatórios de fechamento de ciclo"
  description="As propostas de substituição do catálogo, com a manifestação da PGE dirigida ao IPERON."
>
  <Breadcrumbs itens={[{ label: "Início", href: href("", base) }, { label: "Relatórios de fechamento" }]} />
  <h1>Relatórios de fechamento de ciclo</h1>
  <p class="lead">
    Cada proposta abaixo reúne as regras que a auditoria concluiu que devem ser desativadas e as regras
    propostas que entrariam no lugar delas, agrupadas pela decisão que as reuniu. O documento é a peça em
    que a Procuradoria-Geral do Estado se manifesta, ao IPERON, sobre a substituição.
  </p>
  <p>
    Enquanto o ato institucional não se pratica, o catálogo hoje vigente continua sendo o único em vigor.
  </p>
  <div class="catalog-list">
    {
      propostas.map((proposta) => (
        <EntityCard
          href={href(`relatorio-ciclo/${proposta.id}/`, base)}
          title={proposta.nome}
          id={proposta.id}
          meta={[
            `${proposta.grupos} grupo(s)`,
            `${proposta.origens} regra(s) a desativar`,
            `${proposta.destinos} regra(s) proposta(s)`,
            proposta.situacao,
          ]}
          busca={`${proposta.id} ${proposta.nome}`}
          facetas={{}}
        />
      ))
    }
  </div>
</BaseLayout>
