---
// Listagem das propostas que têm relatório de fechamento.
//
// Existe para que as páginas de `/relatorio-ciclo/<id>/` sejam alcançáveis: o
// relatório em si sai do índice de busca (repete o conteúdo das regras propostas e
// venceria a ficha própria de cada uma), então sem esta listagem ele só seria
// acessível por quem já soubesse a URL.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntityCard from "../../components/EntityCard.astro";
import { href } from "../../consts";
import { homologacoes } from "../../lib/site-data";

const base = import.meta.env.BASE_URL;
const conjuntos = await getCollection("conjuntos");
const conjuntosPorId = new Map(conjuntos.map((entrada) => [entrada.data.id, entrada]));

const propostas = Object.entries(homologacoes).map(([id, proposta]) => ({
  id,
  nome: conjuntosPorId.get(id)?.data.nome ?? id,
  situacao: conjuntosPorId.get(id)?.data.situacao ?? "",
  grupos: proposta.grupos.length,
  origens: new Set(proposta.grupos.flatMap((grupo) => grupo.origens)).size,
  destinos: proposta.linhas.length,
}));
---

<BaseLayout
  title="Relatórios de fechamento de ciclo"
  description="As propostas de substituição do catálogo submetidas à manifestação da PGE."
>
  <Breadcrumbs
    itens={[{ label: "Início", href: href("", base) }, { label: "Relatórios de fechamento" }]}
  />
  <h1>Relatórios de fechamento de ciclo</h1>
  <p class="lead">
    Cada proposta abaixo reúne as regras que a auditoria concluiu que devem ser desativadas e as
    regras propostas que entrariam no lugar delas, agrupadas pela decisão que as reuniu. O documento é o
    instrumento pelo qual a Procuradoria-Geral do Estado se manifesta sobre a substituição.
  </p>
  <p>
    Enquanto a manifestação e o ato institucional não se completam, o catálogo hoje vigente continua
    sendo o único em vigor.
  </p>
  <div class="catalog-list">
    {
      propostas.map((proposta) => (
        <EntityCard
          href={href(`relatorio-ciclo/${proposta.id}/`, base)}
          title={proposta.nome}
          id={proposta.id}
          meta={[
            `${proposta.grupos} grupo(s)`,
            `${proposta.origens} regra(s) a desativar`,
            `${proposta.destinos} regra(s) proposta(s)`,
            proposta.situacao,
          ]}
          busca={`${proposta.id} ${proposta.nome}`}
          facetas={{}}
        />
      ))
    }
  </div>
</BaseLayout>
