.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Preferências pessoais de quem roda Claude Code neste clone; o arquivo
# compartilhado é o CLAUDE.md versionado.
CLAUDE.local.md

# site/ (RFC 0003) — only the generator is committed, never build output or
# the ephemeral emitter it depends on (self-referential: it carries the
# exact source SHA, so committing it would immediately go stale — see
# scripts/emit_site_data.py).
site/node_modules/
site/dist/
# Os anexos servidos ao lado do site nascem do build: os pacotes do repomix e a
# planilha de homologação, que `derivar.py` escreve em `data/` e o emissor só
# copia. O repositório guarda a fonte, nunca a cópia publicada.
site/public/downloads/
site/.astro/
site/src/data/
