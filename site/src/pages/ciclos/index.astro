---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntityCard from "../../components/EntityCard.astro";
import { href } from "../../consts";

const ciclos = (await getCollection("ciclos")).sort((a, b) => a.data.numero - b.data.numero);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Ciclos" description="Ciclos de validação e seus bundles de regras.">
  <h1>Ciclos de validação</h1>
  <p class="lead">Cada ciclo é um bundle declarativo de regras para validação conjunta.</p>
  <div class="catalog-list">
    {ciclos.map((ciclo) => (
      <EntityCard
        href={href(`ciclos/${ciclo.data.id}/`, base)}
        title={ciclo.data.nome}
        id={ciclo.data.id}
        meta={[`${ciclo.data.regras.length} regras`, `${ciclo.data.referencias.length} referências`]}
        busca={`${ciclo.data.id} ${ciclo.data.nome}`}
        facetas={{}}
      />
    ))}
  </div>
</BaseLayout>
