---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntityCard from "../../components/EntityCard.astro";
import { href, REPO_URL } from "../../consts";
import { componentesDoCiclo } from "../../lib/relatorio-ciclo";

export async function getStaticPaths() {
  const ciclos = await getCollection("ciclos");
  return ciclos.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const regras = (await Promise.all(entry.data.regras.map((id) => getEntry("regras", id))))
  .filter((regra): regra is NonNullable<typeof regra> => regra !== undefined);
const referencias = (await Promise.all(entry.data.referencias.map((id) => getEntry("regras", id))))
  .filter((regra): regra is NonNullable<typeof regra> => regra !== undefined);

// O relatório de fechamento existe quando o ciclo tem ao menos um componente
// do grafo origem↔destino entre as suas regras propostas (RFC 0004, round
// 11) — não existe mais um `conjunto` declarado à parte apontando para ele.
const todasPropostas = (await getCollection("regrasPropostas")).map((proposta) => ({
  id: proposta.data.id,
  ciclo: proposta.data.ciclo,
  origensLegacy: (proposta.data.origens_legacy ?? []).map(String),
  estadoAuditoria: proposta.data.estado_auditoria,
  estadoImplantacao: proposta.data.estado_implantacao,
}));
const temRelatorioDeFechamento = componentesDoCiclo(entry.data.id, todasPropostas).length > 0;
---

<BaseLayout title={entry.data.nome} description={`Regras e relatório do ${entry.data.nome}.`}>
  <Breadcrumbs
    itens={[
      { label: "Início", href: href("", base) },
      { label: "Ciclos", href: href("ciclos/", base) },
      { label: entry.data.nome },
    ]}
  />
  <Content />
  <p class="lead">{regras.length} regras neste bundle de validação.</p>
  {
    temRelatorioDeFechamento && (
      <p>
        <a href={href(`relatorio-ciclo/${entry.data.id}/`, base)}>
          Relatório de fechamento deste ciclo
        </a>{" "}
        — a proposta de substituição como documento único, para ler aqui ou imprimir.
      </p>
    )
  }
  <p>
    <a href={`${REPO_URL}/blob/main/okf/regras-sisprev/ciclos/${entry.data.id}.md`}>
      Ver o ciclo e seu relatório no GitHub
    </a>
  </p>
  <h2>Regras proprietárias deste ciclo</h2>
  <div class="catalog-list">
    {regras.map((regra) => (
      <EntityCard
        href={href(`regras/${regra.data.id}/`, base)}
        title={regra.data.nome}
        id={regra.data.id}
        meta={[regra.data.tipo_de_beneficio]}
        busca={`${regra.data.id} ${regra.data.nome} ${regra.data.tipo_de_beneficio}`}
        facetas={{}}
      />
    ))}
  </div>
  {referencias.length > 0 && (
    <>
      <h2>Fichas das referências</h2>
      <p>Estas regras não são reavaliadas neste ciclo; aparecem apenas para contexto ou cotejo transversal.</p>
      <div class="catalog-list">
        {referencias.map((regra) => (
          <EntityCard
            href={href(`regras/${regra.data.id}/`, base)}
            title={regra.data.nome}
            id={regra.data.id}
            meta={[regra.data.tipo_de_beneficio]}
            busca={`${regra.data.id} ${regra.data.nome} ${regra.data.tipo_de_beneficio}`}
            facetas={{}}
          />
        ))}
      </div>
    </>
  )}
</BaseLayout>
