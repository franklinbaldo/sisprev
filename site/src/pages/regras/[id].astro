---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MetadataGrid from "../../components/MetadataGrid.astro";
import RelationList from "../../components/RelationList.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { atosDeValidacao, precedentes } from "../../lib/anotacoes";
import { achadosAffectingRegra, getRegraState } from "../../lib/site-data";
import { regraStatusBadge, validadoBadgeLabel } from "../../lib/status";
import { REGRA_FIELD_GROUPS, campoFormatado, fieldValue, otherFields } from "../../lib/regra-fields";
import { rotuloDaRedacao, rotuloDoEndereco } from "../../lib/dispositivo";
import { href } from "../../consts";

export async function getStaticPaths() {
  const regras = await getCollection("regras");
  return regras.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;

const state = getRegraState(entry.data.id);
const badge = regraStatusBadge(state);

const data = entry.data as unknown as Record<string, unknown>;
const remainingFields = otherFields(data);

const dispositivoIds = entry.data.dispositivos.map((ref) => ref.replace(/^\/dispositivos\//, "").replace(/\.md$/, ""));
const dispositivoEntries = dispositivoIds.length
  ? await Promise.all(dispositivoIds.map((id) => getEntry("dispositivos", id)))
  : [];

// O rótulo de um dispositivo é derivado do endereço estrutural, nunca lido
// de um campo de exibição: a mesma função que ordena e nomeia na listagem
// e no `index.md` gerado pelo Python (P3/P4). Cada item carrega também a
// redação, porque uma regra pode citar duas redações do mesmo dispositivo.
const normasPorId = new Map((await getCollection("normas")).map((n) => [n.data.id, n.data]));

// Anotações de auditoria que não são campos do Sisprev e por isso não entram
// nem nos grupos de campos nem em "Outros campos" — cada uma com seção
// própria, porque confundir um precedente com um ato de validação é
// justamente o que a separação dos dois campos existe para evitar.
const atos = atosDeValidacao(data);
const casos = precedentes(data);

const achadoIds = achadosAffectingRegra(entry.data.id);
const achadoEntries = achadoIds.length ? await Promise.all(achadoIds.map((id) => getEntry("achados", id))) : [];

// Índice da ficha: as seções de campos mais as três seções fixas do fim.
// Uma ficha tem 26 campos em 6 grupos + backlinks + análise; sem índice, o
// leitor que quer só a fundamentação rola a página inteira.
const secoesDoIndice = [
  ...REGRA_FIELD_GROUPS.map((group) => ({ id: group.id, title: group.title })),
  ...(remainingFields.length > 0 ? [{ id: "outros-campos", title: "Outros campos" }] : []),
  ...(atos.length > 0 ? [{ id: "atos-validacao", title: "Atos de validação" }] : []),
  ...(casos.length > 0 ? [{ id: "precedentes", title: "Casos em que foi aplicada" }] : []),
  { id: "dispositivos", title: "Dispositivos citados" },
  { id: "achados", title: "Achados que afetam" },
  { id: "analise", title: "Análise do auditor" },
];
---

<BaseLayout title={entry.data.nome} description={`Regra ${entry.data.id} do catálogo Sisprev.`}>
  <Breadcrumbs
    itens={[
      { label: "Início", href: href("", base) },
      { label: "Regras", href: href("regras/", base) },
      { label: entry.data.id },
    ]}
  />

  {/* O estado de auditoria vai para a busca como *metadado* e sai do texto
      indexado: "Importada" é idêntico nas 112 fichas, então como termo de
      busca ele casa com o catálogo inteiro (o mesmo motivo dos rótulos em
      MetadataGrid). Como metadado ele continua chegando à página de
      resultados, que exibe o selo — a §5 pede o selo em toda superfície, e
      um resultado de busca é uma superfície. */}
  <header class="ficha-cabecalho" data-pagefind-meta={`selo:${badge.label}`}>
    <h1>{entry.data.nome}</h1>
    <p class="ficha-cabecalho__selos" data-pagefind-ignore>
      <StatusBadge tone={badge.tone} label={badge.label} />
      <span class="status-badge" data-tone="neutro">{entry.data.id}</span>
      <span class="status-badge" data-tone="neutro">Ciclo {state.ciclo_de_validacao}</span>
    </p>
    <p class="ficha-cabecalho__validacao" data-pagefind-ignore>
      Validação institucional: <strong>{validadoBadgeLabel(state)}</strong>
    </p>
  </header>

  <div class="ficha-layout">
    <nav class="ficha-indice" aria-label="Índice da ficha">
      <h2>Nesta ficha</h2>
      <ul>
        {secoesDoIndice.map((secao) => <li><a href={`#${secao.id}`}>{secao.title}</a></li>)}
      </ul>
    </nav>

    <div class="ficha-conteudo">
      {
        // A regra deployável inteira (RFC 0003 §3) — todas as 27 colunas do
        // contrato (regra_schema.py COLUMNS), agrupadas por tema; `nome` já é o
        // <h1> acima. Nenhum campo é escolhido a dedo e escondido: um campo
        // futuro que nenhum grupo conhecer cai em "Outros campos" abaixo, nunca
        // desaparece silenciosamente.
        REGRA_FIELD_GROUPS.map((group) => (
          <section>
            <h2 id={group.id}>{group.title}</h2>
            <MetadataGrid
              items={group.fields.map((field) => {
                const valor = campoFormatado(data, field);
                return { label: field.label, value: valor.texto, bruto: valor.bruto, largo: field.largo };
              })}
            />
          </section>
        ))
      }

      {
        remainingFields.length > 0 && (
          <section>
            <h2 id="outros-campos">Outros campos</h2>
            <MetadataGrid
              items={remainingFields.map((field) => ({ label: field.label, value: fieldValue(data, field.key) }))}
            />
          </section>
        )
      }

      {
        atos.length > 0 && (
          <section>
            <h2 id="atos-validacao">Atos de validação</h2>
            <p class="secao-nota">
              As manifestações institucionais que sustentam o estado de
              validação desta regra (P7). É o ato registrado aqui — não a
              aplicação em um caso — que a marca como validada.
            </p>
            <MetadataGrid
              items={atos.map((ato) => ({
                label: `${ato.tipo} · ${ato.autoridade}`,
                value: ato.identificador,
                bruto: ato.fonte,
              }))}
            />
          </section>
        )
      }

      {
        casos.length > 0 && (
          <section>
            <h2 id="precedentes">Casos em que esta regra foi aplicada</h2>
            <p class="secao-nota">
              Precedentes: processos concretos em que a regra foi usada. Ter
              sido aplicada não é ter sido validada — é no processo que um erro
              de regra se materializa, e é por isso que estes casos ficam
              separados dos atos de validação.
            </p>
            <MetadataGrid
              items={casos.map((caso) => ({
                label: caso.fonte,
                value: caso.identificador,
                bruto: caso.observacao || null,
              }))}
            />
          </section>
        )
      }

      <section>
        <h2 id="dispositivos">Dispositivos citados</h2>
        <RelationList
          items={dispositivoEntries
            .filter((d): d is NonNullable<typeof d> => d !== undefined)
            .map((d) => {
              const redacaoId = d.data.id.slice(d.data.id.lastIndexOf("/") + 1);
              const norma = normasPorId.get(d.data.norma);
              const rotulo = `${norma?.apelido ?? d.data.norma}, ${rotuloDoEndereco(d.data.componentes)}`;
              const redacao = rotuloDaRedacao(redacaoId, normasPorId.get(redacaoId)?.apelido);
              return { href: href(`dispositivos/${d.data.id}/`, base), label: `${rotulo} — ${redacao}` };
            })}
          empty="Nenhum dispositivo vinculado ainda."
        />
      </section>

      <section>
        <h2 id="achados">Achados que afetam esta regra</h2>
        <RelationList
          items={achadoEntries
            .filter((a): a is NonNullable<typeof a> => a !== undefined)
            .map((a) => ({ href: href(`achados/${a.data.id}/`, base), label: a.data.nome }))}
          empty="Nenhum achado aberto referencia esta regra."
        />
      </section>

      <section>
        <h2 id="analise">Análise do auditor</h2>
        <p class="secao-nota">
          O corpo do documento é a análise de quem audita — notas de
          reconciliação, questões em aberto, limites de automação. Não é campo
          do Sisprev e não vai para o sistema; a regra deployável é o
          frontmatter acima.
        </p>
        <div class="document-body">
          <Content />
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
