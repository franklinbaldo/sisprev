---
// Grade rótulo/valor dos metadados estruturados de uma ficha.
//
// `bruto` existe para não esconder o catálogo atrás da leitura amigável:
// quando a ficha mostra "Sim" porque a coluna guarda `S`, o valor gravado
// aparece ao lado, em monoespaçado discreto. Quem audita compara com o
// `.md`/CSV; quem só lê ignora o chip sem esforço.
export interface ItemMetadado {
  label: string;
  value: string;
  /** Valor exatamente como está no frontmatter, quando `value` é uma leitura formatada dele. */
  bruto?: string | null;
  /** Ocupa a linha inteira da grade (texto longo, ex.: fundamentação). */
  largo?: boolean;
  /**
   * Destino quando o valor é uma referência navegável dentro do site — o
   * caso da norma de um dispositivo, que resolve numa ficha própria com a
   * publicação oficial. Só o valor vira link; o bruto ao lado continua
   * texto, porque ele é a chave gravada, não a navegação.
   */
  href?: string;
}

interface Props {
  items: ItemMetadado[];
}

const { items } = Astro.props;
---

<dl class="metadata-grid">
  {
    items.map(({ label, value, bruto, largo, href }) => (
      <div class="metadata-grid__item" data-largo={largo ? "" : undefined}>
        {/* Rótulo fora do índice de busca: os mesmos 27 rótulos aparecem nas
            112 fichas, então indexá-los faz cada um casar com o catálogo
            inteiro — buscar "paridade" devolveria 112 páginas, o que é o
            mesmo que não buscar. Quem quer recortar por campo usa o filtro
            da listagem; a busca serve para achar *valor*. O mesmo vale para
            o valor bruto ao lado, que é outra grafia do que está em `dd`
            (indexar "TRUE"/"S"/"N" só adiciona ruído). Ambos continuam
            visíveis e legíveis por leitor de tela — `ignore` só tira do
            índice. */}
        <dt data-pagefind-ignore>{label}</dt>
        <dd>
          {href && value ? <a href={href}>{value}</a> : value || "—"}
          {bruto && (
            <span
              class="metadata-grid__bruto"
              title="valor como está gravado no catálogo"
              data-pagefind-ignore
            >
              {bruto}
            </span>
          )}
        </dd>
      </div>
    ))
  }
</dl>
