---
// Relatório de fechamento de ciclo — a proposta de substituição como um
// documento único, um capítulo por grupo, feito para ser impresso e juntado
// ao processo.
//
// É irmão de `relatorio.astro` e deliberadamente **não** é uma seção dele. Os
// dois manifestam coisas diferentes ao IPERON: aquele analisa as regras como
// estão gravadas, uma por capítulo; este analisa o que a auditoria propõe pôr
// no lugar, um capítulo por **grupo**. Misturá-los faria um documento em que a
// mesma regra aparece duas vezes sob duas conclusões distintas.
//
// Quatro decisões que a página encarna:
//
// - **o que se aprova é o grupo**, não a regra legada nem a proposta. Um grupo
//   ativa e reverte inteiro (RFC 0004 §1.4), então aprovar metade dele
//   deixaria hipótese sem representação ou representada duas vezes. Por isso
//   a conclusão é consignada por capítulo, e capítulo é grupo;
// - **as linhas compiladas vêm do emissor**, nunca recomputadas aqui: o
//   compilador do catálogo auditado é Python, e uma segunda implementação em
//   TypeScript estaria livre para divergir da que o gate confere;
// - **a prosa vem das coleções**, verbatim. A decisão que cada sessão
//   registrou no conjunto e a análise de cada regra proposta entram inteiras, pelo
//   mesmo pipeline de Markdown do resto do site;
// - **a página existe só onde há proposta**. `getStaticPaths` gera uma rota
//   por conjunto com projeção; um conjunto sem grupo não vira relatório de
//   fechamento vazio.
import { createSatteriMarkdownProcessor } from "@astrojs/markdown-satteri";
import { getCollection, getEntry, render } from "astro:content";
import {
  aplicarTotais,
  inlineParaHtml,
  dataCivil,
  janelaDeVigencia,
  nota,
  notasDeSecao,
  pendenciasDoCorpo,
} from "../../lib/relatorio";
import {
  colunasPreenchidas,
  estadoDoGrupoLegivel,
  estadoLegivel,
  linhasDoGrupo,
  partesDoRelatorio,
  resumoDoCiclo,
  tituloDoCapitulo,
} from "../../lib/relatorio-ciclo";
import { href } from "../../consts";
import { compararEnderecos, rotuloDaRedacao, rotuloDoEndereco } from "../../lib/dispositivo";
import { generatedAt, homologacoes } from "../../lib/site-data";
import "../../styles/relatorio.css";

export async function getStaticPaths() {
  return Object.keys(homologacoes).map((id) => ({ params: { id }, props: { id } }));
}

const { id } = Astro.props;
const proposta = homologacoes[id];
const base = import.meta.env.BASE_URL;

const processor = await createSatteriMarkdownProcessor();
const renderizar = async (markdown: string) => (await processor.render(markdown)).code;

const dispositivos = await getCollection("dispositivos");
const dispositivosPorId = new Map(dispositivos.map((entrada) => [entrada.data.id, entrada]));
const normas = await getCollection("normas");
const normasPorId = new Map(normas.map((entrada) => [entrada.data.id, entrada.data]));
const propostas = await getCollection("regrasPropostas");
const propostasPorId = new Map(propostas.map((entrada) => [entrada.data.id, entrada]));
const regras = await getCollection("regras");
const regrasPorId = new Map(regras.map((entrada) => [entrada.data.id, entrada]));

const relatorio = await getEntry("textosDoRelatorioCiclo", "relatorio");
if (!relatorio) {
  throw new Error("docs/relatorio-ciclo/ precisa de relatorio.md");
}
const partes = partesDoRelatorio(relatorio.body ?? "");

// `nota()` estoura na chave ausente, mesma razão do relatório de validação:
// uma seção sem nota sairia sem aviso num documento já juntado ao processo.
const notasCruas = notasDeSecao(partes.notas);
const CHAVES_DE_NOTA = [
  "origens",
  "destinos",
  "projecao",
  "estado",
  "dispositivos",
  "manifestacao",
  "manifestacao-sem-pontos",
  "manifestacao-geral",
] as const;
const notas = Object.fromEntries(
  await Promise.all(CHAVES_DE_NOTA.map(async (chave) => [chave, await renderizar(nota(notasCruas, chave))] as const)),
) as Record<(typeof CHAVES_DE_NOTA)[number], string>;

const resumo = resumoDoCiclo(proposta.grupos, proposta.linhas);

// O corpo dos conjuntos da cadeia **não** entra no documento. Cada sessão da
// auditoria registrou ali a sua decisão, com o vocabulário e o estado daquele
// momento — nomes de sessão, gates, pendências já superadas por sessão
// posterior. Reimprimir a cadeia entregaria a quem recebe o documento o
// caminho percorrido, e não o resultado: quem se manifesta não tem a auditoria
// à mão para saber qual afirmação foi revista depois. O que o documento afirma
// vem do texto editorial e dos capítulos, que descrevem o estado da remessa
// identificada na capa.

const capitulos = await Promise.all(
  proposta.grupos.map(async (grupo, indice) => {
    const linhas = linhasDoGrupo(grupo, proposta.linhas);
    // `proposta.colunas` e não `Object.keys(...)`: o payload é serializado
    // com chaves ordenadas, então ler as colunas de um dict daria ordem
    // alfabética — e um quadro em ordem alfabética não se coteja com a tela
    // do Sisprev, que é para o que ele serve.
    const colunas = colunasPreenchidas(
      proposta.colunas,
      linhas.map((linha) => proposta.linhas.find((l) => l.proposta === linha.proposta)?.colunas ?? {}),
    );
    const destinos = await Promise.all(
      grupo.destinos.map(async (destino) => {
        const entrada = propostasPorId.get(destino);
        const linha = proposta.linhas.find((l) => l.proposta === destino);
        return {
          id: destino,
          // O nome é autorado dentro de `projecao:` na regra proposta e
          // chega aqui pela linha compilada — é literalmente o nome que
          // entraria no cadastro do Sisprev.
          nome: linha?.colunas.NOME ?? "",
          estado: linha?.estado_proposta ?? "",
          deployable: linha?.deployable ?? false,
          pendencias: linha?.pendencias ?? [],
          colunas: linha?.colunas ?? {},
          // As conferências que a auditoria deixou por marcar no corpo da
          // regra proposta. Transcritas como estão: contar `- [ ]` é forma, nunca
          // mérito — o mesmo critério do P7 e do relatório de validação.
          pontos: pendenciasDoCorpo(entrada?.body ?? ""),
          Analise: entrada ? (await render(entrada)).Content : undefined,
        };
      }),
    );
    // O texto integral de cada dispositivo que as regras propostas do capítulo
    // articulam, reimpresso dentro dele. Quem recebe o documento não tem onde
    // conferir a citação: sem o texto ao lado, "art. 30, § 8º, inciso II" é
    // uma referência que só quem tem a lei aberta consegue verificar — e a
    // manifestação é justamente sobre se a regra corresponde ao que a lei diz.
    // A repetição entre capítulos é o preço, e é o preço certo num documento
    // que ninguém lê linearmente.
    // O texto integral de cada dispositivo que as regras propostas do capítulo
    // articulam, reimpresso dentro dele — o mesmo que o relatório de validação
    // faz, pelo mesmo motivo e com a mesma marcação. Quem recebe o documento
    // não tem onde conferir a citação: sem o texto ao lado, "art. 30, § 8º,
    // inciso II" só é verificável por quem já tem a lei aberta, e a
    // manifestação é justamente sobre a regra corresponder ao que a lei diz.
    // A repetição entre capítulos é o preço, e é o preço certo num documento
    // que ninguém lê linearmente.
    const referencias = [
      ...new Set(
        grupo.destinos.flatMap((destino) =>
          (propostasPorId.get(destino)?.data.taxonomias ?? []).map((taxonomia) => taxonomia.ref),
        ),
      ),
    ];
    const citacoes = await Promise.all(
      referencias
        .map((referencia) => ({
          referencia,
          doc: dispositivosPorId.get(referencia.replace(/^\/dispositivos\//, "").replace(/\.md$/, "")),
        }))
        .sort((a, b) => {
          // Sem transcrição não há endereço para ordenar: essas vão ao fim,
          // pela referência, em vez de sumirem no meio da lista.
          if (!a.doc || !b.doc) return a.doc ? -1 : b.doc ? 1 : a.referencia.localeCompare(b.referencia);
          const norma = a.doc.data.norma.localeCompare(b.doc.data.norma);
          return norma !== 0 ? norma : compararEnderecos(a.doc.data.componentes, b.doc.data.componentes);
        })
        .map(async ({ referencia, doc }) => {
          // Uma referência que não resolve não deveria existir num bundle
          // válido, e o site não constrói sobre bundle inválido. Fica
          // representada mesmo assim: omitir em silêncio uma citação declarada
          // seria pior que exibi-la pendente.
          if (!doc) return { referencia, ausente: true as const };

          const redacaoId = doc.data.id.slice(doc.data.id.lastIndexOf("/") + 1);
          const norma = normasPorId.get(doc.data.norma);
          return {
            referencia,
            ausente: false as const,
            citacao: `${norma?.apelido ?? doc.data.norma}, ${rotuloDoEndereco(doc.data.componentes)}`,
            norma: norma?.nome ?? doc.data.norma,
            redacao: rotuloDaRedacao(redacaoId, normasPorId.get(redacaoId)?.apelido),
            vigencia: janelaDeVigencia(doc.data.vigencia_inicio, doc.data.vigencia_fim),
            fontes: doc.data.fontes,
            Texto: (await render(doc)).Content,
          };
        }),
    );
    return {
      indice: indice + 1,
      id: grupo.grupo,
      citacoes,
      grupo,
      colunas,
      destinos,
      origens: grupo.origens.map((origem) => ({
        id: origem,
        nome: typeof regrasPorId.get(origem)?.data.nome === "string" ? regrasPorId.get(origem)!.data.nome : origem,
      })),
      pontos: destinos.flatMap((destino) => destino.pontos),
    };
  }),
);

const capa = {
  titulo: relatorio.data.titulo ?? "Relatório de fechamento de ciclo",
  subtitulo: relatorio.data.subtitulo ?? "",
  orgao: relatorio.data.orgao ?? "",
  processoSei: typeof relatorio.data.processo_sei === "string" ? relatorio.data.processo_sei.trim() : "",
};
// Os números do resumo executivo entram por marcador, nunca literais no
// `.md`: eles mudam a cada remessa, e um relatório assinado que diga "quatro
// regras" depois de a auditoria passar a substituir cinco é erro que ninguém
// relê. `aplicarTotais` estoura em marcador desconhecido, então um nome
// errado derruba o build em vez de imprimir vazio.
const totaisDoCiclo = {
  origens: resumo.origens,
  destinos: resumo.destinos,
  grupos: resumo.grupos,
  gruposAtivos: resumo.gruposAtivos,
  naoAfetadas: regras.length - resumo.origens,
  composicao: regras.length - resumo.origens + resumo.destinos,
  pendencias: resumo.linhasComPendencia,
};
const aberturaHtml = await renderizar(aplicarTotais(partes.abertura, totaisDoCiclo));
const encerramentoHtml = await renderizar(aplicarTotais(partes.encerramento, totaisDoCiclo));
// O nome interno da composição não entra no documento. Ele carrega a etapa da
// revisão que a produziu, e às vezes um recorte que mudou depois — vocabulário
// de quem conduz o trabalho, não de quem o recebe. Quem lê sabe que existem as
// regras, que elas estão sendo revistas por ciclos e que isto é a versão final
// de um ciclo; a capa diz isso e para aí.
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{capa.titulo}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body data-pagefind-ignore>
    {/* Curto de propósito: a caixa `@top-left` dimensiona pelo conteúdo e a
        `@top-right` carrega o id do grupo — um título longo aqui é impresso
        por cima dele. O nome da proposta está na capa e no sumário. */}
    <p class="titulo-corrente">Relatório de fechamento de ciclo de auditoria</p>
    {/* Só na tela: navegação não existe dentro do documento impresso, e o
        WeasyPrint aplica `@media print`, então este bloco não entra no PDF. */}
    <p class="baixar">
      <a href={href(`relatorio-de-ciclo-${id}.pdf`, base)}>Baixar em PDF</a> — versão paginada, com sumário
      e marcadores, para juntar ao processo.
    </p>

    <section class="capa">
      <p class="etiqueta">{capa.orgao}</p>
      <hr class="filete" />
      <h1>{capa.titulo}</h1>
      <p class="subtitulo">{capa.subtitulo}</p>
      <hr class="filete" />

      <div class="rodape-da-capa">
        <div class="painel">
          <table class="resumo">
            <tbody>
              <tr><td>Grupos de substituição analisados</td><td>{resumo.grupos}</td></tr>
              <tr><td>Regras cadastradas a desativar</td><td>{resumo.origens}</td></tr>
              <tr><td>Regras propostas</td><td>{resumo.destinos}</td></tr>
              <tr><td>Grupos já ativados</td><td>{resumo.gruposAtivos}</td></tr>
              <tr><td>Regras liberadas para o sistema</td><td>{resumo.linhasDeployable}</td></tr>
            </tbody>
          </table>
        </div>
        {capa.processoSei && <p class="etiqueta">Processo {capa.processoSei}</p>}
        {/* Quem recebe este documento sabe que existem as regras, que elas
            estão sendo revistas por ciclos e que o que se propõe é a versão
            final de um ciclo. Nada além disso: a capa data a versão e para
            aí. Onde o texto é composto, e com que ferramenta, não diz nada a
            quem se manifesta — e o que não diz nada não entra num documento
            que circula assinado. */}
        <p class="proveniencia">catálogo em: {dataCivil(generatedAt)}</p>
      </div>
    </section>

    <section class="abertura" set:html={aberturaHtml} />

    <section class="abertura sumario">
      <h1>Sumário</h1>
      <ol>
        {
          capitulos.map((capitulo) => (
            <li>
              <span class="ordem">{capitulo.indice}</span>
              <span class="rotulo">{capitulo.id}</span>
              <a class="pagina" href={`#${capitulo.id}`} />
            </li>
          ))
        }
      </ol>
    </section>

    {
      capitulos.map((capitulo) => (
        <section class="capitulo" id={capitulo.id}>
          {/* `string-set` no elemento que contém *só* o id do grupo, mesma
              razão do relatório de validação: a caixa de cabeçalho é estreita
              e a linha inteira quebraria em várias sobre o texto. */}
          <p class="kicker etiqueta">
            Capítulo {capitulo.indice} · grupo <span class="marca">{capitulo.id}</span>
          </p>
          <h1>{tituloDoCapitulo(capitulo.grupo.origens.length, capitulo.grupo.destinos.length)}</h1>
          <ul class="selos">
            <li class="selo">{estadoDoGrupoLegivel(capitulo.grupo.estado_grupo)}</li>
            <li class="selo">
              {capitulo.pontos.length === 1 ? "1 ressalva" : `${capitulo.pontos.length} ressalvas`}
            </li>
          </ul>

          <h2>Regras cadastradas que saem</h2>
          <div class="nota" set:html={notas.origens} />
          <table>
            <thead>
              <tr><th>Regra</th><th>Nome cadastrado</th></tr>
            </thead>
            <tbody>
              {capitulo.origens.map((origem) => (
                <tr>
                  <td><span class="marca">{origem.id}</span></td>
                  <td>{origem.nome}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <h2>Regras propostas que entram</h2>
          <div class="nota" set:html={notas.destinos} />
          <table>
            <thead>
              <tr><th>Regra proposta</th><th>Nome</th><th>Estado</th></tr>
            </thead>
            <tbody>
              {capitulo.destinos.map((destino) => (
                <tr>
                  <td><span class="marca">{destino.id}</span></td>
                  <td>{destino.nome}</td>
                  <td>{estadoLegivel(destino.estado)}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <h2>Projeção nas colunas do Sisprev</h2>
          <div class="nota" set:html={notas.projecao} />
          {/* Uma tabela por regra proposta, em pé — nunca uma matriz de 27
              colunas. Numa folha A4 a matriz **não cabe**, e no impresso não
              existe rolagem: as colunas que passam da margem são cortadas
              sem deixar sinal. Em pé, o quadro cresce para baixo e nada some. */}
          {capitulo.destinos.map((destino) => (
            <>
              <h3><span class="marca">{destino.id}</span></h3>
              <table class="projecao">
                <thead>
                  <tr><th>Coluna do Sisprev</th><th>Valor projetado</th></tr>
                </thead>
                <tbody>
                  {capitulo.colunas.map((coluna) => (
                    <tr>
                      <td>{coluna}</td>
                      <td>{destino.colunas[coluna] ?? ""}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          ))}
          <div class="nota" set:html={notas.estado} />

          <h2>Análise da auditoria, por regra proposta</h2>
          {capitulo.destinos.map((destino) => (
            <>
              <h3>
                <span class="marca">{destino.id}</span>
              </h3>
              {destino.Analise ? <destino.Analise /> : <p>Regra proposta não encontrada no bundle.</p>}
            </>
          ))}

          <h2>Texto dos dispositivos citados</h2>
          <div class="nota" set:html={notas.dispositivos} />
          {capitulo.citacoes.map((citacao) =>
            citacao.ausente ? (
              <div class="dispositivo">
                <p class="citacao">{citacao.referencia}</p>
                <p class="procedencia">Referência declarada sem transcrição correspondente.</p>
              </div>
            ) : (
              <div class="dispositivo">
                <p class="citacao">{citacao.citacao}</p>
                <p class="procedencia">
                  {citacao.norma} · {citacao.redacao} · {citacao.vigencia}
                </p>
                <div class="texto">
                  <citacao.Texto />
                </div>
                <ul class="fontes">
                  {citacao.fontes.map((fonte) => (
                    <li>{fonte}</li>
                  ))}
                </ul>
              </div>
            ),
          )}

          <h2>Manifestação da Procuradoria-Geral do Estado</h2>
          {capitulo.pontos.length === 0 ? (
            <div class="nota" set:html={notas["manifestacao-sem-pontos"]} />
          ) : (
            <>
              <div class="nota" set:html={notas.manifestacao} />
              {capitulo.pontos.map((ponto, ordem) => (
                <div class="ponto">
                  <p class="enunciado">
                    <span class="numero">
                      {capitulo.indice}.{ordem + 1}
                    </span>
                    <Fragment set:html={inlineParaHtml(ponto)} />
                  </p>
                  <div class="resposta">Providência do Instituto:</div>
                </div>
              ))}
            </>
          )}
          <div class="ponto">
            <p class="enunciado">
              {/* Numerada em sequência aos pontos, não como `.0`: um campo
                  "3.0" impresso depois de 3.1–3.4 se lê como item fora de
                  ordem, e a ressalva é referenciada pelo número. */}
              <span class="numero">
                {capitulo.indice}.{capitulo.pontos.length + 1}
              </span>
              <Fragment set:html={inlineParaHtml(nota(notasCruas, "manifestacao-geral"))} />
            </p>
            <div class="resposta ampla">Providência do Instituto:</div>
          </div>
        </section>
      ))
    }

    <section class="abertura">
      <Fragment set:html={encerramentoHtml} />
      <p class="proveniencia">catálogo em {dataCivil(generatedAt)}</p>
      <div class="assinatura">
        <div class="linha"></div>
        <p class="legenda">Procuradoria-Geral do Estado de Rondônia</p>
      </div>
    </section>
  </body>
</html>
