---
// Relatório de validação da PGE — o catálogo inteiro como um documento
// único, um capítulo por regra, feito para ser impresso em PDF e juntado ao
// SEI (`uv run python scripts/gerar_relatorio_pdf.py`).
//
// **É uma projeção congelada do bundle**, exatamente como o CSV derivado e o
// resto do site: gerado, nunca editado à mão; a edição continua acontecendo
// no `regra-*.md`. A diferença entre esta página e a ficha de uma regra é o
// tempo — o site é o catálogo vivo, o PDF é o instante que a PGE recebeu e
// assinou. Por isso o documento carrega o SHA de origem na capa: dois PDFs
// do mesmo catálogo em datas diferentes são documentos diferentes, e o
// processo precisa saber qual dos dois foi juntado.
//
// Três decisões de forma, todas com custo assumido:
//
// - **o capítulo é autocontido**: o texto integral de cada dispositivo
//   citado é reimpresso dentro dele, mesmo que a mesma norma reapareça em
//   dezenas de capítulos. A repetição é o preço de o procurador analisar uma
//   regra sem folhear o volume nem abrir sete PDFs da Casa Civil — e num
//   anexo, que ninguém lê linearmente, é o preço certo;
// - **nada é resumido**: a análise P13.1 e os achados entram verbatim, pelo
//   mesmo pipeline de Markdown do resto do site;
// - **a página fica fora do menu e do índice de busca**. Ela repete o
//   conteúdo de 112 fichas; indexá-la faria qualquer termo do catálogo casar
//   com ela, e ela venceria a ficha própria da regra no resultado.
import { createSatteriMarkdownProcessor } from "@astrojs/markdown-satteri";
import { getCollection, getEntry, render } from "astro:content";
import { REGRA_FIELD_GROUPS, campoFormatado, fieldValue, otherFields } from "../lib/regra-fields";
import { rotuloDaRedacao, rotuloDoEndereco } from "../lib/dispositivo";
import { atosDeValidacao, disposicoesDeAchados, precedentes } from "../lib/anotacoes";
import {
  aplicarTotais,
  inlineParaHtml,
  janelaDeVigencia,
  nota,
  notasDeSecao,
  pendenciasDoCorpo,
  resumoDoRelatorio,
  alcanceDaRemessa,
  tesesDoCatalogo,
} from "../lib/relatorio";
import { formatarValor } from "../lib/formato";
import { REPO_URL, commitUrl, href } from "../consts";
import { generatedAt, sha, shortSha } from "../lib/site-data";
import "../styles/relatorio.css";

const base = import.meta.env.BASE_URL;

const normasPorId = new Map((await getCollection("normas")).map((n) => [n.data.id, n.data]));
const dispositivosPorId = new Map((await getCollection("dispositivos")).map((d) => [d.data.id, d]));
const achados = await getCollection("achados");

// A ordem dos capítulos é o `row_index` da regra — a ordem do próprio
// Sisprev, não a alfabética do nome nem a do arquivo. Quem confere o
// relatório contra o sistema percorre as duas listas em paralelo.
const regras = (await getCollection("regras")).sort(
  (a, b) => Number(a.data.row_index ?? 0) - Number(b.data.row_index ?? 0),
);

const capitulos = await Promise.all(
  regras.map(async (entrada, indice) => {
    const dados = entrada.data as unknown as Record<string, unknown>;
    const { Content: Analise } = await render(entrada);

    const dispositivos = await Promise.all(
      entrada.data.dispositivos.map(async (referencia) => {
        const id = referencia.replace(/^\/dispositivos\//, "").replace(/\.md$/, "");
        const doc = dispositivosPorId.get(id);
        // Uma referência que não resolve não deveria existir num bundle
        // válido — `check_p3_dispositivos` a reprova e o site não constrói
        // sobre bundle inválido. Fica representada mesmo assim: omitir em
        // silêncio uma citação declarada seria pior que exibi-la pendente.
        if (!doc) return { referencia, ausente: true as const };

        const redacaoId = doc.data.id.slice(doc.data.id.lastIndexOf("/") + 1);
        const norma = normasPorId.get(doc.data.norma);
        const { Content: Texto } = await render(doc);
        return {
          referencia,
          ausente: false as const,
          citacao: `${norma?.apelido ?? doc.data.norma}, ${rotuloDoEndereco(doc.data.componentes)}`,
          norma: norma?.nome ?? doc.data.norma,
          redacao: rotuloDaRedacao(redacaoId, normasPorId.get(redacaoId)?.apelido),
          vigencia: janelaDeVigencia(doc.data.vigencia_inicio, doc.data.vigencia_fim),
          fontes: doc.data.fontes,
          Texto,
        };
      }),
    );

    // Só a identificação do achado, nunca o corpo dele: a análise de um defeito
    // é a **tese**, e ela é escrita uma vez, na seção própria. Reimprimi-la aqui
    // punha o mesmo texto em dezenas de capítulos — o `achado-0053` saía escrito
    // sessenta e três vezes — sem que o documento dissesse em lugar nenhum
    // quantas regras aquele defeito alcança.
    const relacionados = achados
      .filter((achado) => achado.data.regras_afetadas.includes(entrada.data.id))
      .map((achado) => ({ dados: achado.data }));

    return {
      indice: indice + 1,
      id: entrada.data.id,
      dados,
      nome: entrada.data.nome,
      tipoDeBeneficio: entrada.data.tipo_de_beneficio,
      Analise,
      dispositivos,
      achados: relacionados,
      atos: atosDeValidacao(dados),
      disposicoes: disposicoesDeAchados(dados),
      precedentes: precedentes(dados),
      pendencias: pendenciasDoCorpo(entrada.body ?? ""),
      camposRestantes: otherFields(dados),
    };
  }),
);

const resumo = resumoDoRelatorio(
  capitulos.map((capitulo) => ({
    tipoDeBeneficio: capitulo.tipoDeBeneficio,
    dispositivos: capitulo.dispositivos.length,
    pendencias: capitulo.pendencias.length,
    achados: capitulo.achados.length,
    achadosAbertos: capitulo.achados.filter((a) => a.dados.situacao === "aberto").length,
  })),
);

// O alcance real da remessa. O documento apresentava 112 capítulos sem dizer
// sobre quantas regras a conferência de mérito concluiu — e um documento
// assinado que não declara o próprio alcance é lido como aprovação de tudo o
// que ele imprime. Os números saem do catálogo, nunca escritos na prosa.
const alcance = alcanceDaRemessa(
  capitulos.map((capitulo) => ({
    statusAuditoria: fieldValue(capitulo.dados, "status_auditoria"),
    disposicoes: capitulo.disposicoes.length,
    ressalvas: capitulo.pendencias.length,
  })),
  achados.map((achado) => ({
    situacao: achado.data.situacao,
    severidade: achado.data.severidade,
  })),
);

// As teses: o achado como unidade da conclusão, e não a regra. O mesmo defeito
// alcança dezenas de linhas do cadastro, e a análise dele é escrita uma vez,
// nomeando as regras que atinge — em vez de reimpressa dentro de cada uma.
const disposicoesPorRegra = new Map(
  capitulos.map((capitulo) => [capitulo.id, capitulo.disposicoes]),
);
const ordemDoCatalogo = capitulos.map((capitulo) => capitulo.id);
const teses = await Promise.all(
  tesesDoCatalogo(
    // Bloqueante antes de informativo, aberto antes de encerrado: a ordem em
    // que quem se manifesta precisa encontrá-las.
    [...achados].sort((a, b) => {
      const peso = (x: typeof a) =>
        (x.data.situacao === "aberto" ? 0 : 2) + (x.data.severidade === "bloqueante" ? 0 : 1);
      return peso(a) - peso(b) || a.data.id.localeCompare(b.data.id);
    }).map((achado) => ({ id: achado.data.id, regras_afetadas: achado.data.regras_afetadas, entrada: achado })),
    ordemDoCatalogo,
    disposicoesPorRegra,
  ).map(async (tese, indice) => ({
    ...tese,
    indice: indice + 1,
    dados: tese.achado.entrada.data,
    Corpo: (await render(tese.achado.entrada)).Content,
  })),
);

// O texto editorial vive em `docs/relatorio/*.md` (coleção
// `textosDoRelatorio`), nunca aqui: é fonte autorada, e quem redige um
// documento que circula assinado precisa reescrever uma frase sem tocar num
// `.astro`. Este arquivo decide apenas onde cada trecho entra.
//
// O processador é o mesmo do resto do site (`satteri`, declarado em
// `astro.config.mjs`); usá-lo sobre uma string é o que permite substituir os
// totais antes de renderizar e renderizar cada nota isoladamente. Um pipeline
// de markdown próprio para o relatório faria o mesmo `.md` render diferente
// aqui e na página de um relatório de análise.
const markdown = await createSatteriMarkdownProcessor({});
const renderizar = async (texto: string) => (await markdown.render(texto)).code;

const totais: Record<string, number> = {
  regras: resumo.regras,
  regrasComDispositivos: resumo.regrasComDispositivos,
  regrasSemDispositivos: resumo.regrasSemDispositivos,
  dispositivosCitados: resumo.dispositivosCitados,
  regrasComPendencia: resumo.regrasComPendencia,
  pendencias: resumo.pendencias,
  regrasComAchado: resumo.regrasComAchado,
  achadosAbertosCitados: resumo.achadosAbertosCitados,
  regrasRevisadas: alcance.revisadas,
  regrasComDisposicao: alcance.comDisposicao,
  regrasComRessalva: alcance.comRessalva,
  tesesAbertas: alcance.tesesAbertas,
  tesesBloqueantes: alcance.tesesBloqueantes,
  teses: teses.length,
};

const abertura = await getEntry("textosDoRelatorio", "abertura");
const encerramento = await getEntry("textosDoRelatorio", "encerramento");
const notasDoRelatorio = await getEntry("textosDoRelatorio", "notas");
if (!abertura || !encerramento || !notasDoRelatorio) {
  throw new Error("docs/relatorio/ precisa de abertura.md, notas.md e encerramento.md");
}

const capa = {
  titulo: abertura.data.titulo ?? "Relatório de validação",
  subtitulo: abertura.data.subtitulo ?? "",
  orgao: abertura.data.orgao ?? "",
  // Vazio até que o processo exista: a capa omite a linha em vez de estampar
  // um número inventado. Um anexo que declara o processo errado é pior que um
  // que não o declara.
  processoSei: typeof abertura.data.processo_sei === "string" ? abertura.data.processo_sei.trim() : "",
};
const aberturaHtml = await renderizar(aplicarTotais(abertura.body ?? "", totais));
const encerramentoHtml = await renderizar(aplicarTotais(encerramento.body ?? "", totais));

// `nota()` estoura na chave ausente: uma seção sem nota sairia sem aviso
// nenhum num documento assinado, e o defeito só apareceria depois de o anexo
// estar juntado ao processo.
const notasCruas = notasDeSecao(notasDoRelatorio.body ?? "");
const CHAVES_DE_NOTA = [
  "parametros",
  "fundamentacao",
  "base-normativa",
  "base-normativa-ausente",
  "analise",
  "achados",
  "teses",
  "limite",
  "atos-validacao",
  "precedentes",
  "manifestacao",
  "manifestacao-sem-pontos",
  "manifestacao-geral",
] as const;
const notas = Object.fromEntries(
  await Promise.all(
    CHAVES_DE_NOTA.map(async (chave) => [chave, await renderizar(nota(notasCruas, chave))] as const),
  ),
) as Record<(typeof CHAVES_DE_NOTA)[number], string>;

// As três colunas de fundamentação saem da grade de parâmetros e ganham
// seção própria: são texto corrido de várias linhas, que numa célula de
// tabela fica ilegível — e é justamente sobre elas que a PGE se manifesta.
const gruposDeParametros = REGRA_FIELD_GROUPS.map((grupo) => ({
  ...grupo,
  fields: grupo.fields.filter((campo) => !campo.largo),
})).filter((grupo) => grupo.fields.length > 0);

const camposDeFundamentacao = REGRA_FIELD_GROUPS.flatMap((grupo) =>
  grupo.fields.filter((campo) => campo.largo),
);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Relatório de validação — regras de aposentadoria e pensão por morte</title>
    <meta name="robots" content="noindex" />
  </head>
  <body data-pagefind-ignore>
    {/* Só na tela: o link é navegação, e navegação não existe dentro do
        documento impresso. O WeasyPrint aplica `@media print`, então este
        bloco não entra no PDF que ele mesmo gera. */}
    <p class="baixar">
      <a href={href("relatorio-de-validacao.pdf", base)}>Baixar em PDF</a> — versão paginada, com sumário
      e marcadores, para juntar ao processo.
    </p>

    <section class="capa">
      {/* Dentro da capa, e não solto no topo do `<body>`: a caixa tem altura
          zero mas continua gerando caixa, então no fluxo impresso ela ocupava
          uma folha inteira antes da capa — a folha 1 do PDF saía em branco e
          numerada, e a capa vinha na 2. Aqui ela cai na página da capa, que
          não leva cabeçalho nem número, e a string continua definida antes de
          qualquer folha que a use. */}
      <p class="titulo-corrente">Relatório de validação · Regras de aposentadoria e pensão por morte</p>
      <p class="etiqueta">{capa.orgao}</p>
      <hr class="filete" />
      <h1>{capa.titulo}</h1>
      <p class="subtitulo">{capa.subtitulo}</p>
      <hr class="filete" />

      <div class="rodape-da-capa">
        <div class="painel">
          <table class="resumo">
            <tbody>
              {/* O quadro declara o **alcance**, não o volume. Ele dizia
                  "regras submetidas: 112" sobre um catálogo com conferência
                  concluída em duas — e num documento assinado o número que
                  aparece na capa é o que se lê como o que foi decidido. */}
              <tr><td>Regras no catálogo</td><td>{alcance.regras}</td></tr>
              <tr><td>Regras com conferência de mérito concluída</td><td>{alcance.revisadas}</td></tr>
              <tr><td>Regras com disposição decidida sobre algum achado</td><td>{alcance.comDisposicao}</td></tr>
              <tr><td>Regras com conferência ainda em curso</td><td>{alcance.comRessalva}</td></tr>
              <tr>
                <td>Teses de auditoria abertas</td>
                <td>{alcance.tesesAbertas} ({alcance.tesesBloqueantes} bloqueantes)</td>
              </tr>
            </tbody>
          </table>
        </div>
        {capa.processoSei && <p class="etiqueta">Processo {capa.processoSei}</p>}
        <p class="proveniencia">
          origem: commit {sha}<br />
          catálogo em: {generatedAt}<br />
          repositório: {REPO_URL}
        </p>
      </div>
    </section>

    <section class="abertura" set:html={aberturaHtml} />

    <section class="abertura sumario">
      <h1>Sumário</h1>
      <ol>
        {
          capitulos.map((capitulo) => (
            <li>
              <span class="ordem">{capitulo.id.replace("regra-", "")}</span>
              <span class="rotulo">{capitulo.nome}</span>
              <a class="pagina" href={`#${capitulo.id}`} />
            </li>
          ))
        }
      </ol>
    </section>

    {/* As teses vêm **antes** dos capítulos, e é a ordem que a mudança de
        unidade exige: o defeito é o que alcança muitas regras, e quem se
        manifesta precisa lê-lo uma vez, inteiro, antes de percorrer as linhas
        do cadastro que ele atinge. Dentro do capítulo fica só a remissão. */}
    <section class="abertura" id="teses">
      <h1>Conclusões, por tese</h1>
      <div class="nota" set:html={notas.teses} />
    </section>

    {
      teses.map((tese) => (
        <section class="capitulo" id={tese.achado.id}>
          <p class="kicker etiqueta">
            Tese {tese.indice} · <span class="marca">{tese.achado.id}</span>
          </p>
          <h1>{tese.dados.nome}</h1>
          <ul class="selos">
            <li class="selo">{tese.dados.situacao}</li>
            <li class="selo">{tese.dados.severidade}</li>
            <li class="selo">{tese.dados.natureza}</li>
            <li class="selo">{tese.regras.length} regra(s) alcançada(s)</li>
          </ul>

          <h2>Análise da auditoria</h2>
          <div class="document-body">
            <tese.Corpo />
          </div>

          <h2>Regras alcançadas</h2>
          {/* Nomeadas uma a uma: é o que permite ao Instituto executar a
              decisão sem reconstruir a lista percorrendo o volume. */}
          <p class="regras-alcancadas">
            {tese.regras.map((id) => <span class="marca">{id}</span>)}
          </p>

          {tese.disposicoes.length > 0 && (
            <>
              <h2>Disposições já decididas</h2>
              <table>
                <thead>
                  <tr><th>Regra</th><th>Disposição</th></tr>
                </thead>
                <tbody>
                  {tese.disposicoes.map((d) => (
                    <tr>
                      <td><span class="marca">{d.regra}</span></td>
                      <td>{d.disposicao}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          <div class="ponto">
            <p class="enunciado">
              <span class="numero">T{tese.indice}</span>
              <Fragment set:html={inlineParaHtml(nota(notasCruas, "manifestacao-geral"))} />
            </p>
            <div class="resposta ampla">Manifestação:</div>
          </div>
        </section>
      ))
    }

    {
      capitulos.map((capitulo) => (
        <section class="capitulo" id={capitulo.id}>
          {/* `string-set` no elemento que contém *só* o id: o cabeçalho de
              cada folha do capítulo passa a dizer de que regra ela é, e a
              caixa de cabeçalho é estreita — pendurar a linha inteira ali a
              faria quebrar em cinco linhas sobre o texto. */}
          <p class="kicker etiqueta">
            Capítulo {capitulo.indice} · <span class="marca">{capitulo.id}</span> · linha{" "}
            {fieldValue(capitulo.dados, "row_index")} do Sisprev
          </p>
          <h1>{capitulo.nome}</h1>
          <ul class="selos">
            <li class="selo">{capitulo.tipoDeBeneficio || "sem tipo declarado"}</li>
            <li class="selo">{capitulo.dispositivos.length} dispositivo(s) citado(s)</li>
            <li class="selo">{capitulo.pendencias.length} ponto(s) a manifestar</li>
            {capitulo.achados.length > 0 && <li class="selo">{capitulo.achados.length} achado(s)</li>}
          </ul>

          <h2>Parâmetros cadastrados</h2>
          <div class="nota" set:html={notas.parametros} />
          {gruposDeParametros.map((grupo) => (
            <>
              <h3>{grupo.title}</h3>
              <table class="parametros">
                <tbody>
                  {grupo.fields.map((campo) => {
                    const valor = campoFormatado(capitulo.dados, campo);
                    return (
                      <tr>
                        <td>{campo.label}</td>
                        <td>
                          {valor.texto ? (
                            <span>{valor.texto}</span>
                          ) : (
                            <span class="vazio">(vazio)</span>
                          )}
                          {valor.bruto && <span class="bruto">{valor.bruto}</span>}
                          {/* A mesma nota da ficha, e aqui ela pesa mais: num
                              anexo impresso, `31/12/2099` sem ressalva é lido
                              como limite real por quem se manifesta sobre a
                              regra. Não diz o que a sentinela significa — diz
                              que o projeto não decidiu (RFC 0011, §5.3.4 do
                              levantamento em aberto). */}
                          {valor.nota && <span class="nota-de-sentinela">{valor.nota}</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </>
          ))}
          {capitulo.camposRestantes.length > 0 && (
            <>
              <h3>Outros campos</h3>
              <table class="parametros">
                <tbody>
                  {capitulo.camposRestantes.map((campo) => (
                    <tr>
                      <td>{campo.label}</td>
                      <td>{fieldValue(capitulo.dados, campo.key) || <span class="vazio">(vazio)</span>}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          <h2>Fundamentação registrada</h2>
          <div class="nota" set:html={notas.fundamentacao} />
          {camposDeFundamentacao.map((campo) => {
            const valor = formatarValor(fieldValue(capitulo.dados, campo.key), campo.formato);
            return (
              <div class="fundamentacao">
                <h3>{campo.key}</h3>
                {valor.texto ? (
                  <blockquote>
                    <p>{valor.texto}</p>
                  </blockquote>
                ) : (
                  <p class="vazio">Campo vazio no cadastro.</p>
                )}
              </div>
            );
          })}

          <h2>Base normativa citada</h2>
          {capitulo.dispositivos.length === 0 ? (
            <div class="nota" set:html={notas["base-normativa-ausente"]} />
          ) : (
            <>
              <div class="nota" set:html={notas["base-normativa"]} />
              {capitulo.dispositivos.map((dispositivo) =>
                dispositivo.ausente ? (
                  <div class="dispositivo">
                    <p class="citacao">{dispositivo.referencia}</p>
                    <p class="procedencia">Referência declarada sem transcrição correspondente.</p>
                  </div>
                ) : (
                  <div class="dispositivo">
                    <p class="citacao">{dispositivo.citacao}</p>
                    <p class="procedencia">
                      {dispositivo.norma} · {dispositivo.redacao} · {dispositivo.vigencia}
                    </p>
                    <div class="texto">
                      <dispositivo.Texto />
                    </div>
                    <ul class="fontes">
                      {dispositivo.fontes.map((fonte) => (
                        <li>{fonte}</li>
                      ))}
                    </ul>
                  </div>
                ),
              )}
            </>
          )}

          <h2>Análise da auditoria</h2>
          <div class="nota" set:html={notas.analise} />
          <div class="document-body">
            <capitulo.Analise />
          </div>

          {capitulo.achados.length > 0 && (
            <>
              <h2>Teses que alcançam esta regra</h2>
              <div class="nota" set:html={notas.achados} />
              {/* Remissão, não reimpressão: a análise da tese está escrita uma
                  vez, na seção própria. A disposição, sim, é desta regra —
                  é ela que diz o que se fez aqui. */}
              <table>
                <thead>
                  <tr><th>Tese</th><th>Defeito</th><th>Disposição nesta regra</th></tr>
                </thead>
                <tbody>
                  {capitulo.achados.map((achado) => (
                    <tr>
                      <td><span class="marca">{achado.dados.id}</span></td>
                      <td>{achado.dados.nome}</td>
                      <td>
                        {capitulo.disposicoes.find((d) => d.achado === achado.dados.id)?.disposicao ?? (
                          <span class="vazio">sem disposição registrada</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {capitulo.precedentes.length > 0 && (
            <>
              <h2>Casos em que esta regra foi aplicada</h2>
              <div class="nota" set:html={notas.precedentes} />
              <table>
                <thead>
                  <tr><th>Referência</th><th>Origem</th><th>Observação</th></tr>
                </thead>
                <tbody>
                  {capitulo.precedentes.map((caso) => (
                    <tr>
                      <td>{caso.identificador}</td>
                      <td>{caso.fonte}</td>
                      <td>{caso.observacao}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {capitulo.atos.length > 0 && (
            <>
              <h2>Atos de validação registrados</h2>
              <div class="nota" set:html={notas["atos-validacao"]} />
              <table>
                <thead>
                  <tr><th>Ato</th><th>Autoridade</th><th>Identificador</th><th>Fonte</th></tr>
                </thead>
                <tbody>
                  {capitulo.atos.map((ato) => (
                    <tr>
                      <td>{ato.tipo}</td>
                      <td>{ato.autoridade}</td>
                      <td>{ato.identificador}</td>
                      <td>{ato.fonte}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {capitulo.pendencias.length > 0 && (
            <>
              <h2>Limite desta conferência</h2>
              {/* **Declarado, não submetido.** Estes itens eram impressos como
                  "pontos submetidos a manifestação", cada um com sua caixa de
                  resposta — 321 no catálogo inteiro. Mas são as conferências
                  que a própria auditoria deixou por fazer ("os dispositivos
                  declarados não foram conferidos um a um"), e pedir que o
                  Instituto as responda é transferir a ele o trabalho que esta
                  peça deveria trazer pronto. Ficam à vista, sem caixa de
                  resposta: quem recebe precisa saber o que ainda não foi
                  conferido. */}
              <div class="nota" set:html={notas.limite} />
              <ul class="ressalvas">
                {capitulo.pendencias.map((pendencia) => (
                  <li set:html={inlineParaHtml(pendencia)} />
                ))}
              </ul>
            </>
          )}

          <h2>Manifestação da Procuradoria-Geral do Estado</h2>
          <div
            class="nota"
            set:html={capitulo.pendencias.length === 0 ? notas["manifestacao-sem-pontos"] : notas.manifestacao}
          />
          <div class="ponto">
            <p class="enunciado">
              <span class="numero">{capitulo.indice}</span>
              <Fragment set:html={inlineParaHtml(nota(notasCruas, "manifestacao-geral"))} />
            </p>
            <div class="resposta ampla">Manifestação:</div>
          </div>
        </section>
      ))
    }

    <section class="abertura fecho">
      <Fragment set:html={encerramentoHtml} />
      <p class="proveniencia">
        gerado a partir de {commitUrl(sha)}<br />
        commit {shortSha} · catálogo em {generatedAt}
      </p>
      <div class="assinatura">
        <div class="linha"></div>
        <p class="legenda">Procuradoria-Geral do Estado de Rondônia</p>
      </div>
    </section>
  </body>
</html>
