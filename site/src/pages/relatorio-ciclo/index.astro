---
// Listagem das propostas que têm relatório de fechamento.
//
// Existe para que as páginas de `/relatorio-ciclo/<id>/` sejam alcançáveis: o
// relatório em si sai do índice de busca (repete o conteúdo das regras
// propostas e venceria a ficha própria de cada uma), então sem esta listagem
// ele só seria acessível por quem já soubesse a URL.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntityCard from "../../components/EntityCard.astro";
import { href } from "../../consts";
import { componentesDoCiclo } from "../../lib/relatorio-ciclo";

const base = import.meta.env.BASE_URL;
const ciclos = await getCollection("ciclos");
const todasPropostas = (await getCollection("regrasPropostas")).map((entrada) => ({
  id: entrada.data.id,
  ciclo: entrada.data.ciclo,
  origensLegacy: (entrada.data.origens_legacy ?? []).map(String),
  estadoAuditoria: entrada.data.estado_auditoria,
  estadoImplantacao: entrada.data.estado_implantacao,
}));

const propostas = ciclos
  .map((entrada) => ({ entrada, componentes: componentesDoCiclo(entrada.data.id, todasPropostas) }))
  .filter(({ componentes }) => componentes.length > 0)
  .map(({ entrada, componentes }) => ({
    id: entrada.data.id,
    nome: entrada.data.nome,
    componentes: componentes.length,
    // Sem repetição, pela mesma razão da capa: a mesma regra legada em dois
    // componentes contada duas vezes afirma uma proposta maior que a real.
    origens: new Set(componentes.flatMap((c) => c.origens)).size,
    destinos: new Set(componentes.flatMap((c) => c.destinos)).size,
  }))
  .sort((a, b) => a.id.localeCompare(b.id, "pt-BR"));
---

<BaseLayout
  title="Relatórios de fechamento de ciclo"
  description="As propostas de substituição do catálogo, com a manifestação da PGE dirigida ao IPERON."
>
  <Breadcrumbs itens={[{ label: "Início", href: href("", base) }, { label: "Relatórios de fechamento" }]} />
  <h1>Relatórios de fechamento de ciclo</h1>
  <p class="lead">
    Cada proposta abaixo reúne as regras que a auditoria concluiu que devem ser desativadas e as regras
    propostas que entrariam no lugar delas, agrupadas pelo componente do grafo origem↔destino que as
    conecta. O documento é a peça em que a Procuradoria-Geral do Estado se manifesta, ao IPERON, sobre a
    substituição.
  </p>
  <p>
    Enquanto o ato institucional não se pratica, o catálogo hoje vigente continua sendo o único em vigor.
  </p>
  <div class="catalog-list">
    {
      propostas.map((proposta) => (
        <EntityCard
          href={href(`relatorio-ciclo/${proposta.id}/`, base)}
          title={proposta.nome}
          id={proposta.id}
          meta={[
            `${proposta.componentes} componente(s)`,
            `${proposta.origens} regra(s) a desativar`,
            `${proposta.destinos} regra(s) proposta(s)`,
          ]}
          busca={`${proposta.id} ${proposta.nome}`}
          facetas={{}}
        />
      ))
    }
  </div>
</BaseLayout>
