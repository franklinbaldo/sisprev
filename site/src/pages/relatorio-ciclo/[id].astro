---
// Relatório de fechamento de ciclo — a proposta de substituição como um
// documento único, um capítulo por componente do grafo origem↔destino, feito
// para ser impresso e juntado ao processo.
//
// É irmão de `relatorio.astro` e deliberadamente **não** é uma seção dele. Os
// dois manifestam coisas diferentes ao IPERON: aquele analisa as regras como
// estão gravadas, uma por capítulo; este analisa o que a auditoria propõe pôr
// no lugar, um capítulo por **componente**. Misturá-los faria um documento em
// que a mesma regra aparece duas vezes sob duas conclusões distintas.
//
// Quatro decisões que a página encarna:
//
// - **o que se aprova é o componente**, não a regra legada nem a proposta
//   isolada. Um componente — o conjunto de regras propostas que compartilham,
//   direta ou transitivamente, uma origem legada (RFC 0004, round 11;
//   `okf/spec/regraproposta.md`) — entra ou sai da carga de homologação por
//   inteiro, então aprovar metade dele deixaria hipótese sem representação ou
//   representada duas vezes. Por isso a conclusão é consignada por capítulo,
//   e capítulo é componente;
// - **tudo vem das coleções**, verbatim: as regras propostas e a projeção
//   saem do frontmatter autorado, a análise de cada uma sai do corpo, pelo
//   mesmo pipeline de Markdown do resto do site. Nada aqui recomputa o que a
//   auditoria escreveu — só agrupa por origem compartilhada;
// - **o valor projetado é lido, não reformatado**, e um limite sentinela leva
//   a mesma ressalva da ficha. Num anexo impresso `31/12/2099` sem ressalva é
//   lido como fronteira real por quem assina;
// - **a página existe só onde há componente**. `getStaticPaths` gera uma
//   rota por ciclo que tenha ao menos uma regra proposta; um ciclo sem
//   proposta não vira relatório de fechamento vazio.
import { createSatteriMarkdownProcessor } from "@astrojs/markdown-satteri";
import { getCollection, getEntry, render } from "astro:content";
import {
  aplicarTotais,
  inlineParaHtml,
  dataCivil,
  itensNaoMarcadosDoHtml,
  janelaDeVigencia,
  nota,
  notasDeSecao,
} from "../../lib/relatorio";
import {
  celulasDaProjecao,
  componentesDoCiclo,
  consolidarPontos,
  destinosComRessalvaDoCiclo,
  estadoDoComponenteLegivel,
  estadoLegivel,
  partesDoRelatorio,
  resumoDoCiclo,
  tituloDoCapitulo,
} from "../../lib/relatorio-ciclo";
import { REGRA_FIELD_GROUPS, campoFormatado } from "../../lib/regra-fields";
import { href, SITE_URL } from "../../consts";
import { compararEnderecos, rotuloDaRedacao, rotuloDoEndereco } from "../../lib/dispositivo";
import { generatedAt } from "../../lib/site-data";
import "../../styles/relatorio.css";

export async function getStaticPaths() {
  const ciclos = await getCollection("ciclos");
  const todasPropostas = (await getCollection("regrasPropostas")).map((entrada) => ({
    id: entrada.data.id,
    ciclo: entrada.data.ciclo,
    origensLegacy: (entrada.data.origens_legacy ?? []).map(String),
    estadoAuditoria: entrada.data.estado_auditoria,
    estadoImplantacao: entrada.data.estado_implantacao,
  }));
  return ciclos
    .filter((entrada) => componentesDoCiclo(entrada.data.id, todasPropostas).length > 0)
    .map((entrada) => ({ params: { id: entrada.data.id }, props: { ciclo: entrada } }));
}

const { ciclo } = Astro.props;
const id = ciclo.data.id;
const base = import.meta.env.BASE_URL;

const processor = await createSatteriMarkdownProcessor();
const renderizar = async (markdown: string) => (await processor.render(markdown)).code;

const dispositivos = await getCollection("dispositivos");
const dispositivosPorId = new Map(dispositivos.map((entrada) => [entrada.data.id, entrada]));
const normas = await getCollection("normas");
const normasPorId = new Map(normas.map((entrada) => [entrada.data.id, entrada.data]));
const propostas = await getCollection("regrasPropostas");
const propostasPorId = new Map(propostas.map((entrada) => [entrada.data.id, entrada]));
const regras = await getCollection("regras");
const regrasPorId = new Map(regras.map((entrada) => [entrada.data.id, entrada]));

const relatorio = await getEntry("textosDoRelatorioCiclo", "relatorio");
if (!relatorio) {
  throw new Error("docs/relatorio-ciclo/ precisa de relatorio.md");
}
const partes = partesDoRelatorio(relatorio.body ?? "");

// `nota()` estoura na chave ausente, mesma razão do relatório de validação:
// uma seção sem nota sairia sem aviso num documento já juntado ao processo.
const notasCruas = notasDeSecao(partes.notas);
const CHAVES_DE_NOTA = [
  "origens",
  "destinos",
  "projecao",
  "dispositivos",
  "manifestacao",
  "manifestacao-sem-pontos",
  "manifestacao-geral",
] as const;
const notas = Object.fromEntries(
  await Promise.all(CHAVES_DE_NOTA.map(async (chave) => [chave, await renderizar(nota(notasCruas, chave))] as const)),
) as Record<(typeof CHAVES_DE_NOTA)[number], string>;

// Os componentes vêm do grafo origem↔destino entre as regras propostas deste
// ciclo — computados aqui, não declarados num manifesto à parte (RFC 0004,
// round 11).
const propostasDoGrafo = propostas.map((entrada) => ({
  id: entrada.data.id,
  ciclo: entrada.data.ciclo,
  origensLegacy: (entrada.data.origens_legacy ?? []).map(String),
  estadoAuditoria: entrada.data.estado_auditoria,
  estadoImplantacao: entrada.data.estado_implantacao,
  ressalvaHomologacao: entrada.data.ressalva_homologacao,
}));
const componentes = componentesDoCiclo(id, propostasDoGrafo);

// As colunas do Sisprev na ordem canônica da ficha — nunca `Object.keys` da
// projeção, que sairia na ordem em que cada unidade a escreveu. Um quadro em
// ordem variável não se coteja com a tela do sistema, que é para o que ele
// serve. O corpo não imprime valor de campo; o anexo imprime, uma folha por
// regra.
// Sem os campos longos — as três `fundamentacao*`. Elas são parágrafos
// inteiros, e com elas cada regra ocupava duas ou três folhas, o que desfaz o
// que o anexo é para ser: uma folha por regra, citável por número. O texto
// delas não se perde — vai na planilha, e a análise que as justifica está na
// ficha da regra. O que fica aqui é o que se confere de relance: identidade,
// janela, causa, cálculo e paridade.
const CAMPOS = REGRA_FIELD_GROUPS.flatMap((grupo) => grupo.fields).filter((campo) => !campo.largo);

// As colunas estão escritas em dois lugares da unidade: `projecao` traz a
// maioria e `aplicabilidade_temporal.datas_legadas` traz as de data. As duas
// entram — um anexo sem as janelas não permite conferir qual regra alcança um
// requerimento.
const colunasDaUnidade = (dados: Record<string, unknown>) => ({
  ...((dados.projecao ?? {}) as Record<string, unknown>),
  ...(((dados.aplicabilidade_temporal as Record<string, unknown>)?.datas_legadas ?? {}) as Record<string, unknown>),
});

const linhas = propostas
  .filter((entrada) => componentes.some((c) => c.destinos.includes(entrada.data.id)))
  .map((entrada) => ({
    proposta: entrada.data.id,
    colunas: celulasDaProjecao(colunasDaUnidade(entrada.data)),
  }));
const linhasPorProposta = new Map(linhas.map((linha) => [linha.proposta, linha]));

const resumo = resumoDoCiclo(componentes, propostasDoGrafo);

const capitulos = await Promise.all(
  componentes.map(async (componente, indice) => {
    const capituloId = `componente-${indice + 1}`;
    const destinos = await Promise.all(
      componente.destinos.map(async (destino) => {
        const entrada = propostasPorId.get(destino);
        const linha = linhasPorProposta.get(destino);
        return {
          id: destino,
          // O nome é autorado dentro de `projecao:` na regra proposta — é
          // literalmente o nome que entraria no cadastro do Sisprev.
          nome: linha?.colunas.nome ?? "",
          estado: entrada?.data.estado_auditoria ?? "",
          dados: entrada ? colunasDaUnidade(entrada.data) : {},
          colunas: linha?.colunas ?? {},
          // As conferências que a auditoria deixou por marcar no corpo da
          // regra proposta. Transcritas como estão: contar `- [ ]` é forma,
          // nunca mérito — o mesmo critério do relatório de validação. Vêm
          // do HTML já renderizado (mesmo `renderizar` de `partes.abertura`
          // logo abaixo), não de um scanner de Markdown à parte.
          pontos: itensNaoMarcadosDoHtml(await renderizar(entrada?.body ?? "")),
          Analise: entrada ? (await render(entrada)).Content : undefined,
        };
      }),
    );
    // O texto integral de cada dispositivo que as regras propostas do capítulo
    // articulam, reimpresso dentro dele — o mesmo que o relatório de validação
    // faz, pelo mesmo motivo. Quem recebe o documento não tem onde conferir a
    // citação: sem o texto ao lado, "art. 30, § 8º, inciso II" só é verificável
    // por quem já tem a lei aberta, e a manifestação é justamente sobre a regra
    // corresponder ao que a lei diz. A repetição entre capítulos é o preço, e é
    // o preço certo num documento que ninguém lê linearmente.
    const referencias = [
      ...new Set(
        componente.destinos.flatMap((destino) =>
          (propostasPorId.get(destino)?.data.taxonomias ?? []).map((taxonomia) => taxonomia.ref),
        ),
      ),
    ];
    const citacoes = await Promise.all(
      referencias
        .map((referencia) => ({
          referencia,
          doc: dispositivosPorId.get(referencia.replace(/^\/dispositivos\//, "").replace(/\.md$/, "")),
        }))
        .sort((a, b) => {
          // Sem transcrição não há endereço para ordenar: essas vão ao fim,
          // pela referência, em vez de sumirem no meio da lista.
          if (!a.doc || !b.doc) return a.doc ? -1 : b.doc ? 1 : a.referencia.localeCompare(b.referencia);
          const norma = a.doc.data.norma.localeCompare(b.doc.data.norma);
          return norma !== 0 ? norma : compararEnderecos(a.doc.data.componentes, b.doc.data.componentes);
        })
        .map(async ({ referencia, doc }) => {
          // Uma referência que não resolve não deveria existir num bundle
          // válido. Fica representada mesmo assim: omitir em silêncio uma
          // citação declarada seria pior que exibi-la pendente.
          if (!doc) return { referencia, ausente: true as const };

          const redacaoId = doc.data.id.slice(doc.data.id.lastIndexOf("/") + 1);
          const norma = normasPorId.get(doc.data.norma);
          return {
            referencia,
            ausente: false as const,
            citacao: `${norma?.apelido ?? doc.data.norma}, ${rotuloDoEndereco(doc.data.componentes)}`,
            norma: norma?.nome ?? doc.data.norma,
            redacao: rotuloDaRedacao(redacaoId, normasPorId.get(redacaoId)?.apelido),
            vigencia: janelaDeVigencia(doc.data.vigencia_inicio, doc.data.vigencia_fim),
            fontes: doc.data.fontes,
            // O papel que as regras propostas deste capítulo atribuem à
            // provisão vem antes da transcrição: é afirmação da Procuradoria
            // sobre a norma, e é o que diz o que uma remissão importa.
            papeis: [
              ...new Set(
                componente.destinos.flatMap((destino) =>
                  (propostasPorId.get(destino)?.data.taxonomias ?? [])
                    .filter((taxonomia) => taxonomia.ref === referencia && taxonomia.papel)
                    .map((taxonomia) => taxonomia.papel as string),
                ),
              ),
            ],
            Texto: (await render(doc)).Content,
          };
        }),
    );
    return {
      indice: indice + 1,
      id: capituloId,
      citacoes,
      componente,
      destinos,
      origens: componente.origens.map((origem) => ({
        id: origem,
        nome: typeof regrasPorId.get(origem)?.data.nome === "string" ? regrasPorId.get(origem)!.data.nome : origem,
      })),
      // Consolidadas por enunciado, não concatenadas: uma dependência
      // sistêmica é escrita em cada regra que alcança, e concatenar imprimia
      // dezenove campos "Providência do Instituto" para a mesma pendência.
      pontos: consolidarPontos(destinos),
    };
  }),
);

const capa = {
  titulo: relatorio.data.titulo ?? "Relatório de fechamento de ciclo",
  subtitulo: relatorio.data.subtitulo ?? "",
  orgao: relatorio.data.orgao ?? "",
  processoSei: typeof relatorio.data.processo_sei === "string" ? relatorio.data.processo_sei.trim() : "",
};
// Os números do resumo executivo entram por marcador, nunca literais no
// `.md`: eles mudam a cada remessa, e um relatório assinado que diga "quatro
// regras" depois de a auditoria passar a substituir cinco é erro que ninguém
// relê. `aplicarTotais` estoura em marcador desconhecido, então um nome
// errado derruba o build em vez de imprimir vazio.
// Quantas regras propostas estão em grupo pronto — o texto editorial fecha a
// conta "destinos = na carga + fora da carga" com estes dois marcadores, em
// vez de deixar o leitor deduzi-la dos selos de capítulo. Desde RFC 0004
// round 12, `confirmada_com_ressalva` também conta como pronto (entra na
// carga de homologação levando ressalva); `destinosComRessalva` isola
// quantos desses destinos levam ressalva, para a prosa distinguir carga de
// ativação em produção sem inventar número novo fora do marcador.
const destinosNaCarga = componentes
  .filter((componente) => componente.pronto)
  .reduce((soma, componente) => soma + componente.destinos.length, 0);
const destinosComRessalva = destinosComRessalvaDoCiclo(componentes, propostasDoGrafo);
const totaisDoCiclo = {
  origens: resumo.origens,
  destinos: resumo.destinos,
  grupos: resumo.componentes,
  gruposAtivos: resumo.componentesProntos,
  destinosNaCarga,
  destinosForaDaCarga: resumo.destinos - destinosNaCarga,
  destinosComRessalva,
  // Marcador de frase, não de número: a prosa que descreve as ressalvas da
  // carga precisa concordar com a contagem, e um `{{destinosComRessalva}}`
  // cru já saiu impresso como "1 são as regras de causa comum" quando a
  // carga passou de duas ressalvas para uma.
  regrasComRessalva:
    destinosComRessalva === 1
      ? "1 regra entra com ressalva de homologação"
      : `${destinosComRessalva} regras entram com ressalva de homologação`,
  naoAfetadas: regras.length - resumo.origens,
  composicao: regras.length - resumo.origens + resumo.destinos,
};
const aberturaHtml = await renderizar(aplicarTotais(partes.abertura, totaisDoCiclo));
const encerramentoHtml = await renderizar(aplicarTotais(partes.encerramento, totaisDoCiclo));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{capa.titulo}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body data-pagefind-ignore>
    {/* Só na tela: navegação não existe dentro do documento impresso, e o
        WeasyPrint aplica `@media print`, então este bloco não entra no PDF. */}
    <p class="baixar">
      <a href={href(`relatorio-de-ciclo-${id}.pdf`, base)}>Baixar em PDF</a> — versão paginada, com sumário
      e marcadores, para juntar ao processo.
    </p>

    <section class="capa">
      {/* Dentro da capa, e não antes dela: `.titulo-corrente` tem altura zero
          mas **gera caixa** — precisa gerar, porque elemento sem caixa não
          define `string-set`. Solto no corpo, essa caixa caía na página
          nomeada padrão e consumia uma folha inteira antes da capa: a folha 1
          do PDF saía em branco e numerada, e a capa vinha na 2. Aqui ela cai
          na página da capa, que não leva cabeçalho nem número, e a string
          continua definida antes de qualquer folha que a use. É o mesmo
          defeito que `relatorio.astro` já havia corrigido; ele não tinha sido
          propagado para cá.

          Curto de propósito: a caixa `@top-left` dimensiona pelo conteúdo e a
          `@top-right` carrega o id do componente — um título longo aqui é
          impresso por cima dele. */}
      <p class="titulo-corrente">Relatório de fechamento de ciclo de auditoria</p>
      <p class="etiqueta">{capa.orgao}</p>
      <hr class="filete" />
      <h1>{capa.titulo}</h1>
      <p class="subtitulo">{capa.subtitulo}</p>
      <hr class="filete" />

      <div class="rodape-da-capa">
        <div class="painel">
          <table class="resumo">
            <tbody>
              <tr><td>Componentes analisados</td><td>{resumo.componentes}</td></tr>
              <tr><td>Regras cadastradas a desativar</td><td>{resumo.origens}</td></tr>
              <tr><td>Regras propostas</td><td>{resumo.destinos}</td></tr>
              <tr><td>Componentes prontos para homologação</td><td>{resumo.componentesProntos}</td></tr>
              <tr><td>Regras concluídas na auditoria</td><td>{resumo.linhasConcluidas}</td></tr>
            </tbody>
          </table>
        </div>
        {capa.processoSei && <p class="etiqueta">Processo {capa.processoSei}</p>}
        <p class="proveniencia">catálogo em: {dataCivil(generatedAt)}</p>
      </div>
    </section>

    <section class="abertura" set:html={aberturaHtml} />

    <section class="abertura sumario">
      <h1>Sumário</h1>
      <ol>
        {
          capitulos.map((capitulo) => (
            <li>
              <span class="ordem">{capitulo.indice}</span>
              {/* O título editorial primeiro; o id do componente fica ao lado,
                  como rastreio — um sumário que só diz "componente-1" não
                  orienta quem decide sobre o documento. */}
              <span class="rotulo">
                {tituloDoCapitulo(capitulo.componente.origens.length, capitulo.componente.destinos.length)}
                {" · "}
                <span class="marca">{capitulo.id}</span>
              </span>
              <a class="pagina" href={`#${capitulo.id}`} />
            </li>
          ))
        }
      </ol>
    </section>

    {
      capitulos.map((capitulo) => (
        <section class="capitulo" id={capitulo.id}>
          {/* `string-set` no elemento que contém *só* o id do componente,
              mesma razão do relatório de validação: a caixa de cabeçalho é
              estreita e a linha inteira quebraria em várias sobre o texto. */}
          {/* Sem a palavra "componente" solta antes do id: como o próprio id
              é `componente-N`, o kicker imprimia "COMPONENTE COMPONENTE-1". */}
          <p class="kicker etiqueta">
            Capítulo {capitulo.indice} · <span class="marca">{capitulo.id}</span>
          </p>
          <h1>{tituloDoCapitulo(capitulo.componente.origens.length, capitulo.componente.destinos.length)}</h1>
          <ul class="selos">
            <li class="selo">{estadoDoComponenteLegivel(capitulo.componente.pronto)}</li>
            <li class="selo">
              {capitulo.pontos.length === 1 ? "1 ressalva" : `${capitulo.pontos.length} ressalvas`}
            </li>
          </ul>

          <h2>Regras cadastradas que saem</h2>
          <div class="nota" set:html={notas.origens} />
          <table>
            <thead>
              <tr><th>Regra</th><th>Nome cadastrado</th></tr>
            </thead>
            <tbody>
              {capitulo.origens.map((origem) => (
                <tr>
                  <td><span class="marca">{origem.id}</span></td>
                  <td>{origem.nome}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <h2>Regras propostas que entram</h2>
          <div class="nota" set:html={notas.destinos} />
          <table>
            <thead>
              <tr><th>Regra proposta</th><th>Nome</th><th>Estado da auditoria</th></tr>
            </thead>
            <tbody>
              {capitulo.destinos.map((destino) => (
                <tr>
                  <td><span class="marca">{destino.id}</span></td>
                  <td>{destino.nome}</td>
                  <td>{estadoLegivel(destino.estado)}</td>
                </tr>
              ))}
            </tbody>
          </table>

          {/* A projeção nas colunas do Sisprev **não** entra no corpo. Ela
              ocupava quarenta quadros de vinte e oito linhas, e ninguém
              confere valor de campo folheando um PDF: confere-se em planilha,
              ao lado do export do sistema. É por isso que ela virou o anexo
              que este documento sempre prometeu, e que agora existe.

              A análise autorada de cada unidade saiu pela mesma razão de
              proporção: o corpo manifesta o que é comum às quarenta e o que
              muda em relação às regras de origem; o raciocínio unidade a
              unidade fica na ficha de cada uma, onde ele é consultável. */}
          <h2>Texto dos dispositivos citados</h2>
          <div class="nota" set:html={notas.dispositivos} />
          {capitulo.citacoes.map((citacao) =>
            citacao.ausente ? (
              <div class="dispositivo">
                <p class="citacao">{citacao.referencia}</p>
                <p class="procedencia">Referência declarada sem transcrição correspondente.</p>
              </div>
            ) : (
              <div class="dispositivo">
                <p class="citacao">{citacao.citacao}</p>
                <p class="procedencia">
                  {citacao.norma} · {citacao.redacao} · {citacao.vigencia}
                </p>
                {citacao.papeis.map((papel) => (
                  <p class="papel">{papel}</p>
                ))}
                <div class="texto">
                  <citacao.Texto />
                </div>
                <ul class="fontes">
                  {citacao.fontes.map((fonte) => (
                    <li>{fonte}</li>
                  ))}
                </ul>
              </div>
            ),
          )}

          <h2>Manifestação da Procuradoria-Geral do Estado</h2>
          {capitulo.pontos.length === 0 ? (
            <div class="nota" set:html={notas["manifestacao-sem-pontos"]} />
          ) : (
            <>
              <div class="nota" set:html={notas.manifestacao} />
              {capitulo.pontos.map((ponto, ordem) => (
                <div class="ponto">
                  <p class="enunciado">
                    <span class="numero">
                      {capitulo.indice}.{ordem + 1}
                    </span>
                    {/* `ponto.html` já é o HTML interno do `<li>` renderizado —
                        preservado como veio, sem reconverter para Markdown. */}
                    <Fragment set:html={ponto.html} />
                  </p>
                  {/* Uma pendência que alcança várias regras propostas sai uma
                      vez só, e o alcance vai declarado: sem isso, consolidar
                      esconderia quantas regras ficam condicionadas a ela. */}
                  {ponto.regras.length > 1 && (
                    <p class="alcance">
                      Alcança {ponto.regras.length} regras propostas deste grupo:{" "}
                      {ponto.regras.map((regra, i) => (
                        <>
                          {i > 0 ? ", " : ""}
                          <span class="marca">{regra}</span>
                        </>
                      ))}.
                    </p>
                  )}
                  <div class="resposta">Providência do Instituto:</div>
                </div>
              ))}
            </>
          )}
          <div class="ponto">
            <p class="enunciado">
              {/* Numerada em sequência aos pontos, não como `.0`: um campo
                  "3.0" impresso depois de 3.1–3.4 se lê como item fora de
                  ordem, e a ressalva é referenciada pelo número. */}
              <span class="numero">
                {capitulo.indice}.{capitulo.pontos.length + 1}
              </span>
              <Fragment set:html={inlineParaHtml(nota(notasCruas, "manifestacao-geral"))} />
            </p>
            <div class="resposta ampla">Providência do Instituto:</div>
          </div>
        </section>
      ))
    }

    {/* `fecho` junto de `abertura`: a tipografia é a mesma, a numeração não.
        Sem ele a seção herdava `page: abertura` e o encerramento saía em
        romano no fim de um documento em arábico — o leitor via 50, `li`,
        `lii`, 53, e quem citasse "página 51" não a encontrava. Mesmo defeito
        que `relatorio.css` documenta ter corrigido no relatório de validação,
        não propagado para cá. */}
    <section class="abertura fecho">
      {/* Apaga o id do último componente do cabeçalho: daqui em diante as
          folhas não pertencem a componente algum, e o carimbo residual as
          atribuiria ao grupo errado. */}
      <p class="limpa-marca" />
      <Fragment set:html={encerramentoHtml} />
      {/* O anexo que o documento promete, e o único lugar em que os valores
          de campo aparecem. No impresso o endereço vai por extenso: um PDF
          juntado ao processo é lido em papel, e link sem endereço legível é
          link que não existe para quem o recebe assim. */}
      <div class="planilha">
        <h2>Planilha das regras propostas</h2>
        <div class="nota" set:html={notas.projecao} />
        <p>
          <a href={href("downloads/regras-propostas.csv", base)}>regras-propostas.csv</a>
        </p>
        <p class="endereco">{new URL(href("downloads/regras-propostas.csv", base), SITE_URL).href}</p>
        <p>
          Cada regra proposta projetada nas colunas do próprio Sisprev, do jeito que entraria, com
          colunas de proveniência que identificam de que regra cadastrada a linha descende e em que
          estado a auditoria a deixou.
        </p>
      </div>
      <p class="proveniencia">catálogo em {dataCivil(generatedAt)}</p>
      <div class="assinatura">
        <div class="linha"></div>
        <p class="legenda">Procuradoria-Geral do Estado de Rondônia</p>
      </div>
    </section>

    {/* O anexo: uma folha por regra proposta, com os valores que ela gravaria.
        No corpo isto era ilegível — quarenta quadros intercalados à prosa, e
        a mudança sumindo no meio da repetição. Numa folha por regra, é o que
        um anexo deve ser: não se lê, consulta-se, e a folha se cita por
        número. É a mesma matéria da planilha, em superfície diferente: a
        planilha existe para importar e cotejar com o export do sistema; o
        anexo, para conferir sem sair do documento assinado. */}
    <section class="anexo">
      <h1>Anexo — as regras propostas, uma por folha</h1>
      <p>
        Cada folha adiante traz uma regra proposta com os valores que ela gravaria nas colunas do
        Sisprev, na ordem em que o sistema os apresenta. A mesma matéria está na planilha indicada
        acima, em formato importável.
      </p>
    </section>

    {
      capitulos.flatMap((capitulo) =>
        capitulo.destinos.map((destino) => (
          <section class="anexo-regra" id={destino.id}>
            <p class="kicker etiqueta">
              Anexo · <span class="marca">{destino.id}</span>
            </p>
            <h1>{destino.nome}</h1>
            <ul class="selos">
              <li class="selo">componente {capitulo.id}</li>
              <li class="selo">substitui {capitulo.origens.map((origem) => origem.id).join(", ")}</li>
              <li class="selo">{estadoLegivel(destino.estado)}</li>
            </ul>
            <p class="nota-do-anexo">
              As três fundamentações são parágrafos inteiros e não cabem nesta folha: estão na
              planilha, na íntegra.
            </p>
            <table class="projecao">
              <thead>
                <tr>
                  <th>Coluna do Sisprev</th>
                  <th>Valor projetado</th>
                </tr>
              </thead>
              <tbody>
                {CAMPOS.map((campo) => {
                  const valor = campoFormatado(destino.dados, campo);
                  return (
                    <tr>
                      <td>{campo.label}</td>
                      <td>
                        {valor.texto ? <span>{valor.texto}</span> : <span class="vazio">(vazio)</span>}
                        {valor.bruto && <span class="bruto">{valor.bruto}</span>}
                        {/* Num anexo impresso a ressalva pesa mais que na
                            tela: `31/12/2099` sem ela é lido como limite real
                            por quem se manifesta sobre a regra. */}
                        {valor.nota && <span class="nota-de-sentinela">{valor.nota}</span>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        )),
      )
    }
  </body>
</html>
